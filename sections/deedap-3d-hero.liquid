{% comment %}
  DEEDAP — 100% Full-Width Ultra-HD Diwali Hero Poster
  Features live cycling Women’s Kurtas & Suits deals in arch windows with prices, buy links, and full festive animations.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,600;1,700&family=Manrope:wght@500;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">

<style>
@property --ang{syntax:'<angle>';inherits:false;initial-value:0deg}
@property --n{syntax:'<integer>';inherits:false;initial-value:50}
.dd-3d-hero-outer{font-family:'Manrope',system-ui,sans-serif !important;}
.dd-3d-hero-scaler a{text-decoration:none !important;}
.p3{transform-style:preserve-3d}

/* ===== whole-poster 3D entrance + stable position ===== */
.enter{animation:enter 2s cubic-bezier(.16,.9,.2,1) both}
@keyframes enter{0%{opacity:0;transform:translateY(120px) rotateX(50deg) scale(.82)}60%{opacity:1}100%{opacity:1;transform:none}}

/* Keep poster rock-solid in place (NO 3D SWAY WOBBLE) */
.sway {
  animation: none !important;
  transform: none !important;
}

/* travelling gold light on the poster edge */
.edge{position:absolute;left:0;top:0;width:1290px;height:640px;box-sizing:border-box;border-radius:28px;padding:3px;background:conic-gradient(from var(--ang),rgba(245,196,81,.35) 0deg,rgba(245,196,81,.35) 250deg,#FFE9A8 330deg,#FFFFFF 358deg,rgba(245,196,81,.35) 360deg);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0);mask-composite:exclude;animation:spin 6s linear infinite;pointer-events:none}
@keyframes spin{to{--ang:360deg}}
.rot{transform-box:fill-box;transform-origin:50% 50%;animation:rot 90s linear infinite}
.rotr{transform-box:fill-box;transform-origin:50% 50%;animation:rot 60s linear infinite reverse}
@keyframes rot{to{transform:rotate(360deg)}}
.halo{animation:halo 5s ease-in-out infinite alternate}
@keyframes halo{0%{opacity:.7;transform:scale(.95)}100%{opacity:1;transform:scale(1.08)}}

.twink{transform-box:fill-box;transform-origin:50% 50%;animation:twink 2.2s ease-in-out infinite}
@keyframes twink{0%,100%{opacity:.25;transform:scale(.4)}50%{opacity:1;transform:scale(1.25)}}
.bulb{animation:bulb 2.4s ease-in-out infinite}
@keyframes bulb{0%,100%{opacity:.35}50%{opacity:1}}
.wire{animation:wirein 1.4s ease .6s both}
@keyframes wirein{0%{transform:translateY(-60px);opacity:0}100%{transform:none;opacity:1}}

/* ===== type ===== */
.ln{display:block;white-space:nowrap}
.ch{display:inline-block;animation:letterIn 1s cubic-bezier(.2,1.1,.3,1) var(--d) both,hop 5s ease-in-out calc(var(--d) + 4s) infinite}
.sp1{display:inline-block;width:.28em}
@keyframes letterIn{0%{opacity:0;transform:perspective(500px) translateY(46px) rotateX(-85deg) scale(.7);filter:blur(6px)}100%{opacity:1;transform:none;filter:blur(0)}}
@keyframes hop{0%,88%,100%{transform:translateY(0)}94%{transform:translateY(-7px)}}
.rise{animation:rise 1s cubic-bezier(.2,.9,.2,1) var(--t) both}
@keyframes rise{0%{opacity:0;transform:translate3d(0,40px,0)}100%{opacity:1;transform:none}}
.reveal{display:block;overflow:hidden}
.reveal > span{display:block;animation:reveal 1.2s cubic-bezier(.2,.9,.2,1) var(--t) both}
@keyframes reveal{0%{transform:translateY(110%)}100%{transform:none}}
.shine{background:linear-gradient(90deg,#E8B44C 0%,#FFF3C4 45%,#E8B44C 70%,#FFE29A 100%);background-size:240% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shine 3.2s linear infinite}
@keyframes shine{0%{background-position:240% 0}100%{background-position:-240% 0}}
.sweep{position:absolute;top:0;bottom:0;left:0;width:40%;background:linear-gradient(105deg,rgba(255,255,255,0),rgba(255,255,255,.4),rgba(255,255,255,0));animation:glare 4.5s ease-in-out 2.5s infinite}
@keyframes glare{0%,20%{transform:translateX(-120%) skewX(-20deg)}40%,100%{transform:translateX(380%) skewX(-20deg)}}

/* number counter */
.pop{counter-reset:num var(--n);animation:count 2.4s cubic-bezier(.2,.9,.3,1) 2.2s both}
@keyframes count{from{--n:0}to{--n:50}}
.count::after{content:counter(num)}
.ring{position:absolute;left:-20px;top:-18px;width:110px;height:110px;border-radius:50%;border:2px solid #F5C451;animation:ring 2.8s cubic-bezier(.1,.7,.3,1) 3.5s infinite;opacity:0;pointer-events:none}
@keyframes ring{0%{opacity:.8;transform:scale(.3)}100%{opacity:0;transform:scale(1.6)}}

/* button */
.btn{transition:transform .2s ease,box-shadow .2s ease}
.btn:hover{transform:translateY(-2px) scale(1.03);box-shadow:0 14px 28px rgba(0,0,0,.45)}
.pulse{animation:btnpulse 2.8s ease-in-out 3.8s infinite}
@keyframes btnpulse{0%{box-shadow:0 0 0 0 rgba(255,246,224,.55)}70%,100%{box-shadow:0 0 0 18px rgba(255,246,224,0)}}

/* ===== arch windows: continuous scrolling women's kurtas deals ===== */
.arch{position:absolute;overflow:hidden;border-radius:120px 120px 14px 14px;border:2.5px solid #F5C451;background:#1A0509;box-shadow:0 0 0 7px rgba(245,196,81,.12),0 35px 65px rgba(0,0,0,.65),0 0 50px rgba(245,196,81,.18);animation:archin 1.5s cubic-bezier(.2,.9,.2,1) var(--t) both}
@keyframes archin{0%{opacity:0;transform:translateY(120px) scale(.94)}100%{opacity:1;transform:none}}
.archline{position:absolute;left:8px;top:8px;right:8px;bottom:8px;border-radius:112px 112px 8px 8px;border:1px solid rgba(255,226,154,.55);pointer-events:none;z-index:10}
.view{position:absolute;left:0;top:0;right:0;bottom:0;-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 11%,#000 89%,transparent 100%);mask-image:linear-gradient(180deg,transparent 0,#000 11%,#000 89%,transparent 100%);overflow:hidden}
.col{will-change:transform}
.up{animation:scrollup 28s linear infinite !important}
.down{animation:scrollup 32s linear infinite reverse !important}
@keyframes scrollup{0%{transform:translateY(0)}100%{transform:translateY(-1500px)}}
.arch:hover .col{animation-play-state:paused !important}

/* Product Tile Styling (Model photo top 215px, Caption bottom 85px) */
.tile{position:relative !important;width:100% !important;height:300px !important;overflow:hidden !important;display:block !important;text-decoration:none !important;cursor:pointer !important;box-sizing:border-box !important}
.tile-img-box{position:absolute !important;left:0 !important;top:0 !important;width:100% !important;height:215px !important;overflow:hidden !important;background:#12030A !important}
.tile-product-img{width:100% !important;height:100% !important;object-fit:cover !important;object-position:top center !important;display:block !important;transition:transform .4s ease !important}
.tile:hover .tile-product-img{transform:scale(1.06) !important}

.tshine{position:absolute;top:0;bottom:0;left:0;width:45%;background:linear-gradient(105deg,rgba(255,255,255,0),rgba(255,255,255,.35),rgba(255,255,255,0));animation:glare 5s ease-in-out infinite;pointer-events:none}
.cap{position:absolute !important;left:0 !important;right:0 !important;bottom:0 !important;height:85px !important;box-sizing:border-box !important;padding:6px 10px 10px !important;background:linear-gradient(180deg,rgba(15,2,7,0.7) 0%,rgba(15,2,7,0.96) 35%,#12030A 100%) !important;display:flex !important;flex-direction:column !important;align-items:center !important;justify-content:center !important;gap:3px !important;text-align:center !important;z-index:4 !important}
.nm{font-family:'Cormorant Garamond',Georgia,serif !important;font-style:italic !important;font-weight:700 !important;font-size:18px !important;line-height:1.1 !important;color:#FFF6E0 !important;white-space:nowrap !important;overflow:hidden !important;text-overflow:ellipsis !important;max-width:220px !important;display:block !important}
.tile-price-row{display:flex !important;align-items:baseline !important;gap:7px !important;line-height:1 !important}
.tile-price{font-family:'Syne',sans-serif !important;font-weight:800 !important;font-size:15px !important;color:#F5C451 !important;letter-spacing:-0.01em !important}
.tile-compare{font-family:'Manrope',sans-serif !important;font-weight:600 !important;font-size:11.5px !important;color:rgba(255,246,224,0.55) !important;text-decoration:line-through !important}
.tile-buy-btn{font-family:'Syne',sans-serif !important;font-weight:800 !important;font-size:9.5px !important;letter-spacing:0.12em !important;text-transform:uppercase !important;color:#3A0A12 !important;background:#F5C451 !important;padding:3px 10px !important;border-radius:999px !important;display:inline-block !important;line-height:1.3 !important;transition:transform .2s ease,background .2s ease !important}
.tile:hover .tile-buy-btn{background:#FFF6E0 !important;transform:scale(1.06) !important}

.bgn{background:radial-gradient(ellipse at 50% 32%,#5A2E40,#150810)}
.bgr{background:radial-gradient(ellipse at 50% 30%,#7C6A55,#1C1612)}
.bgp{background:radial-gradient(ellipse at 50% 30%,#584234,#1C1612)}
.bgj{background:radial-gradient(ellipse at 50% 30%,#184A48,#0B1F1E)}
.bge{background:radial-gradient(ellipse at 50% 30%,#1C523A,#071B12)}
.bgb{background:radial-gradient(ellipse at 50% 30%,#5E1624,#1A050A)}
.bgo{background:radial-gradient(ellipse at 50% 30%,#66461D,#221405)}
.bgx{background:radial-gradient(ellipse at 50% 30%,#4A1224,#150408)}

/* ===== fireworks, embers, petals ===== */
.fw{--s:1;position:absolute;width:0;height:0}
.fw .core{position:absolute;left:-7px;top:-7px;width:14px;height:14px;border-radius:50%;background:var(--c);box-shadow:0 0 22px 8px var(--c);opacity:0;animation:flash 5s var(--dl) ease-out infinite}
.fw .sp{position:absolute;left:0;top:0;width:22px;height:3px;border-radius:3px;background:linear-gradient(90deg,rgba(255,255,255,0),var(--c));transform-origin:0 50%;opacity:0;--d:100px;animation:spark 5s var(--dl) cubic-bezier(.1,.7,.3,1) infinite}
.fw .sp.b{--d:62px;background:linear-gradient(90deg,rgba(255,255,255,0),var(--c2));width:16px}
@keyframes spark{0%{opacity:0;transform:rotate(var(--a)) translateX(0) scaleX(.2)}6%{opacity:1}45%{opacity:1;transform:rotate(var(--a)) translateX(calc(var(--d)*var(--s))) scaleX(1)}70%{opacity:.8}100%{opacity:0;transform:rotate(var(--a)) translateX(calc(var(--d)*var(--s)*1.3)) translateY(26px) scaleX(.3)}}
@keyframes flash{0%{opacity:0;transform:scale(.2)}5%{opacity:1;transform:scale(1.4)}25%,100%{opacity:0;transform:scale(2.4)}}
.flame{transform-box:fill-box;transform-origin:50% 100%;animation:ignite .6s var(--t) both,flame .9s calc(var(--t) + .6s) ease-in-out infinite alternate}
.glow{transform-box:fill-box;transform-origin:50% 50%;animation:ignite .6s var(--t) both,glowp 1.6s calc(var(--t) + .6s) ease-in-out infinite alternate}
@keyframes ignite{0%{transform:scale(0);opacity:0}100%{transform:scale(1);opacity:1}}
@keyframes flame{0%{transform:scale(1,1);opacity:.85}100%{transform:scale(.8,1.3);opacity:1}}
@keyframes glowp{0%{opacity:.15;transform:scale(.8)}100%{opacity:.6;transform:scale(1.5)}}
.ember{position:absolute;bottom:50px;width:4px;height:4px;border-radius:50%;background:#FFD76A;box-shadow:0 0 10px 3px rgba(255,190,70,.85);opacity:0;animation:ember linear infinite}
@keyframes ember{0%{opacity:0;transform:translate3d(0,0,90px)}10%{opacity:1}50%{transform:translate3d(var(--dx),-210px,90px)}100%{opacity:0;transform:translate3d(calc(var(--dx)*-.6),-440px,90px)}}
.petal{position:absolute;top:0;border-radius:60% 40% 60% 40%;background:radial-gradient(circle at 35% 30%,#FFD76A,#EE7F14 72%);animation:fallA linear infinite;opacity:0}
.petalB{animation-name:fallB}
@keyframes fallA{0%{opacity:0;transform:translate3d(0,-40px,110px) rotate(0deg)}8%{opacity:1}50%{transform:translate3d(-34px,290px,110px) rotate(260deg)}92%{opacity:.9}100%{opacity:0;transform:translate3d(24px,600px,110px) rotate(540deg)}}
@keyframes fallB{0%{opacity:0;transform:translate3d(0,-40px,110px) rotate(0deg)}8%{opacity:1}50%{transform:translate3d(36px,290px,110px) rotate(-240deg)}92%{opacity:.9}100%{opacity:0;transform:translate3d(-26px,600px,110px) rotate(-520deg)}}

@media (prefers-reduced-motion: reduce){*{animation:none !important;transition:none !important}.petal,.ember,.fw .sp,.fw .core{opacity:0}}

/* ===== CONTAINER & SIZE CONTROL ===== */
.dd-3d-hero-outer {
  width: 100% !important;
  max-width: 100vw !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
  position: relative !important;
  display: flex !important;
  justify-content: center !important;
  align-items: flex-start !important;
  background: #080104 !important;
  clear: both !important;
}

.dd-3d-hero-scaler {
  width: 1350px !important;
  height: 720px !important;
  transform-origin: top center !important;
  position: relative !important;
  flex-shrink: 0 !important;
}

/* ========================================= */
/* ===== MOBILE: hide desktop, show mob ===== */
/* ========================================= */
.dd-mob-hero { display: none !important; }

@media (max-width: 767px) {
  /* Hide the desktop scaled poster */
  .dd-3d-hero-outer { display: none !important; }

  /* Show mobile hero */
  .dd-mob-hero {
    display: block !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #080104 !important;
    overflow: hidden !important;
    font-family: 'Manrope', system-ui, sans-serif !important;
    -webkit-font-smoothing: antialiased !important;
  }
  .dd-mob-hero a { text-decoration: none !important; }

  /* --- Mobile poster card --- */
  .mob-poster {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    border-radius: 0;
    overflow: hidden;
    background: radial-gradient(ellipse 80% 70% at 50% 30%, #6A1128 0%, #330815 46%, #12030A 100%);
  }

  /* --- Mobile top section: text + CTA --- */
  .mob-top {
    position: relative;
    padding: 28px 20px 20px;
    z-index: 5;
  }
  .mob-presents {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.34em;
    color: #F5C451;
    margin-bottom: 4px;
  }
  .mob-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 700;
    font-size: 34px;
    line-height: 1.08;
    background: linear-gradient(90deg, #E8B44C 0%, #FFF3C4 45%, #E8B44C 70%, #FFE29A 100%);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3.2s linear infinite;
    margin-bottom: 10px;
  }
  .mob-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid rgba(245,196,81,.7);
    background: rgba(255,246,224,.06);
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #FFE9A8;
    margin-bottom: 12px;
  }
  .mob-headline {
    font-family: 'Syne', 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 26px;
    line-height: 1.15;
    color: #FFF6E0;
    text-shadow: 0 4px 20px rgba(245,196,81,.3);
    margin-bottom: 10px;
  }
  .mob-headline-gold { color: #F5C451; }
  .mob-desc {
    font-size: 12px;
    line-height: 1.6;
    font-weight: 500;
    color: #EBD3B6;
    margin-bottom: 16px;
    max-width: 320px;
  }

  /* Offer row */
  .mob-offer-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
  }
  .mob-discount {
    display: flex;
    align-items: flex-start;
    gap: 4px;
  }
  .mob-discount-num {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 52px;
    line-height: 1;
    background: linear-gradient(90deg, #E8B44C, #FFF3C4, #E8B44C);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3.2s linear infinite;
  }
  .mob-discount-labels {
    display: flex;
    flex-direction: column;
    padding-top: 6px;
  }
  .mob-discount-pct {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 20px;
    color: #F5C451;
  }
  .mob-discount-off {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 14px;
    color: #FFF6E0;
  }
  .mob-upto {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.34em;
    color: #F5C451;
    margin-bottom: 2px;
  }
  .mob-divider {
    width: 1px;
    align-self: stretch;
    background: linear-gradient(180deg, rgba(245,196,81,0), rgba(245,196,81,.5), rgba(245,196,81,0));
  }
  .mob-cta-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mob-shop-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 999px;
    background: #FFF6E0;
    color: #3A0A12;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.1em;
  }
  .mob-offer-end {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #FBE9CF;
  }

  /* --- NEW DEALS UNLOCKED banner --- */
  .mob-deals-label {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 0;
    background: linear-gradient(90deg, #F5C451, #FFE9A8 50%, #F5C451);
  }
  .mob-deals-label span {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.14em;
    color: #3A0A12;
  }

  /* --- Mobile arch windows: side by side --- */
  .mob-arches-wrap {
    position: relative;
    display: flex;
    gap: 10px;
    padding: 14px 10px 0;
    justify-content: center;
    background: radial-gradient(ellipse 90% 80% at 50% 20%, #3A0A18 0%, #12030A 100%);
  }
  .mob-arch {
    position: relative;
    width: calc(50% - 5px);
    max-width: 180px;
    height: 420px;
    overflow: hidden;
    border-radius: 90px 90px 10px 10px;
    border: 2px solid #F5C451;
    background: #1A0509;
    box-shadow: 0 0 0 5px rgba(245,196,81,.08), 0 20px 40px rgba(0,0,0,.6);
  }
  .mob-arch .view {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 10%, #000 90%, transparent 100%);
    overflow: hidden;
  }
  .mob-arch .archline {
    position: absolute;
    left: 6px; top: 6px; right: 6px; bottom: 6px;
    border-radius: 84px 84px 6px 6px;
    border: 1px solid rgba(255,226,154,.45);
    pointer-events: none;
    z-index: 10;
  }

  /* Mobile tiles */
  .mob-arch .tile {
    height: 240px !important;
  }
  .mob-arch .tile-img-box {
    height: 170px !important;
  }
  .mob-arch .cap {
    height: 70px !important;
    padding: 4px 6px 8px !important;
  }
  .mob-arch .nm {
    font-size: 13px !important;
    max-width: 160px !important;
  }
  .mob-arch .tile-price {
    font-size: 12px !important;
  }
  .mob-arch .tile-compare {
    font-size: 9.5px !important;
  }
  .mob-arch .tile-buy-btn {
    font-size: 7.5px !important;
    padding: 2px 8px !important;
    letter-spacing: 0.08em !important;
  }

  /* Mobile scrollup keyframes for smaller tiles */
  .mob-arch .col.up {
    animation: mob-scrollup 24s linear infinite !important;
  }
  .mob-arch .col.down {
    animation: mob-scrollup 28s linear infinite reverse !important;
  }

  /* --- Mobile festive ribbon --- */
  .mob-ribbon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 10px;
    background: linear-gradient(90deg, #F5C451, #FFE9A8 50%, #F5C451);
    overflow: hidden;
    white-space: nowrap;
  }
  .mob-ribbon-text {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 8.5px;
    letter-spacing: 0.15em;
    color: #3A0A12;
    text-transform: uppercase;
  }
  .mob-ribbon-dot {
    font-size: 6px;
    opacity: 0.6;
  }

  /* diya row on mobile */
  .mob-diyas {
    display: flex;
    justify-content: space-around;
    padding: 10px 20px 16px;
    background: #12030A;
  }
}

/* 5 items * 240px = 1200px per half */
@keyframes mob-scrollup {
  0% { transform: translateY(0); }
  100% { transform: translateY(-1200px); }
}

</style>

<div class="dd-3d-hero-outer" id="dd-diwali-hero-container">
  <div class="dd-3d-hero-scaler" id="dd-diwali-hero-scaler">
    <div id="dd-diwali-stage" style="position: relative; width: 1350px; height: 720px; perspective: 1200px; display: flex; align-items: center; justify-content: center;">

      <!-- ===== STAGE CARD ===== -->
      <div class="enter sway p3" style="position: absolute; left: 30px; top: 40px; width: 1290px; height: 640px;">
