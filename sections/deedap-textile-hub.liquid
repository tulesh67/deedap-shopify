<section class="dd-textile-landing" aria-labelledby="dd-textile-title">
  {%- liquid
    assign men_url = "/men/clothing/"
    assign women_url = "/women/kurtas/"
    assign kids_url = "/kids/clothing/"
  -%}
  <div class="dd-textile-landing__inner">
    <p class="dd-textile-landing__eyebrow">DEEDAP · CLOTHING &amp; TEXTILES</p>
    <h1 id="dd-textile-title">WEAR WHAT FEELS <span>LIKE YOU.</span></h1>

    <div class="dd-textile-banners">
      <a href="{{ men_url }}" class="dd-textile-banner" aria-label="Explore Men’s clothing">
        <img src="{{ 'textiles-men-premium.png' | asset_url }}" alt="Men’s everyday clothing" loading="lazy" width="900" height="1100">
        <span class="dd-textile-banner__shade" aria-hidden="true"></span>
        <span class="dd-textile-banner__number">01 / TEXTILES</span>
        <span class="dd-textile-banner__copy">
          <span class="dd-textile-banner__kicker">EASY, EVERYDAY LAYERS</span>
          <strong>MEN</strong>
          <span class="dd-textile-banner__description">Versatile staples and thoughtful details for wherever the day takes you.</span>
          <span class="dd-textile-banner__action">EXPLORE MEN <i aria-hidden="true">→</i></span>
        </span>
      </a>

      <a href="{{ women_url }}" class="dd-textile-banner" aria-label="Explore Women’s clothing">
        <img src="{{ 'textiles-women-premium.png' | asset_url }}" alt="Women’s everyday clothing" loading="lazy" width="900" height="1100">
        <span class="dd-textile-banner__shade" aria-hidden="true"></span>
        <span class="dd-textile-banner__number">02 / TEXTILES</span>
        <span class="dd-textile-banner__copy">
          <span class="dd-textile-banner__kicker">A LITTLE ROOM TO SHINE</span>
          <strong>WOMEN</strong>
          <span class="dd-textile-banner__description">Comfortable silhouettes and expressive pieces, chosen to feel like you.</span>
          <span class="dd-textile-banner__action">EXPLORE WOMEN <i aria-hidden="true">→</i></span>
        </span>
      </a>

      <a href="{{ kids_url }}" class="dd-textile-banner" aria-label="Explore Kids’ clothing">
        <img src="{{ 'textiles-kids-premium.png' | asset_url }}" alt="Kids’ everyday clothing" loading="lazy" width="900" height="1100">
        <span class="dd-textile-banner__shade" aria-hidden="true"></span>
        <span class="dd-textile-banner__number">03 / TEXTILES</span>
        <span class="dd-textile-banner__copy">
          <span class="dd-textile-banner__kicker">READY FOR EVERY ADVENTURE</span>
          <strong>KIDS</strong>
          <span class="dd-textile-banner__description">Soft, durable favorites for curious minds and busy little days.</span>
          <span class="dd-textile-banner__action">EXPLORE KIDS <i aria-hidden="true">→</i></span>
        </span>
      </a>
    </div>
    {% render 'deedap-textile-collection-grid', textile_collection: section.settings.men_collection, category_title: 'Men', category_id: 'men-products', section_id: section.id %}
    {% render 'deedap-textile-collection-grid', textile_collection: section.settings.women_collection, category_title: 'Women', category_id: 'women-products', section_id: section.id %}
    {% render 'deedap-textile-collection-grid', textile_collection: section.settings.kids_collection, category_title: 'Kids', category_id: 'kids-products', section_id: section.id %}
  </div>
</section>

<script src="{{ 'deedap-textile-gallery.js' | asset_url }}" defer="defer"></script>

<style>
  .dd-textile-landing{background:#fff;color:#171311;padding:clamp(26px,4vw,54px) 22px 48px}
  .dd-textile-landing__inner{max-width:1540px;margin:0 auto}
  .dd-textile-landing__eyebrow{margin:0 0 9px;color:#64182b;font-size:10px;font-weight:850;letter-spacing:.2em;text-align:center}
  .dd-textile-landing h1{margin:0 0 clamp(20px,3vw,34px);font-family:var(--font-heading-family,'Syne',sans-serif);font-size:clamp(28px,5vw,60px);font-weight:800;line-height:1.05;letter-spacing:.015em;text-align:center}
  .dd-textile-landing h1 span{color:#64182b}
  .dd-textile-banners{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,2vw,30px)}
  .dd-textile-banner{position:relative;display:block;min-height:560px;aspect-ratio:.82;overflow:hidden;border:1.5px solid #b8923a;border-radius:30px;background:#30251d;color:#fff;text-decoration:none;isolation:isolate;box-shadow:0 16px 36px rgba(35,24,16,.12)}
  .dd-textile-banner>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 28%;transition:transform .7s cubic-bezier(.2,.8,.2,1)}
  .dd-textile-banner:hover>img{transform:scale(1.035)}
  .dd-textile-banner__shade{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(18,13,10,.1) 0%,rgba(18,13,10,.14) 34%,rgba(18,13,10,.82) 100%)}
  .dd-textile-banner__number{position:absolute;top:24px;left:24px;z-index:2;padding:10px 16px;border:1px solid rgba(255,255,255,.6);border-radius:999px;background:rgba(16,12,10,.36);font-size:11px;font-weight:800;letter-spacing:.14em}
  .dd-textile-banner__copy{position:absolute;right:28px;bottom:28px;left:28px;z-index:2;display:flex;flex-direction:column;align-items:flex-start}
  .dd-textile-banner__kicker{margin-bottom:12px;color:#f0d99b;font-size:10px;font-weight:800;letter-spacing:.15em}
  .dd-textile-banner__copy strong{font-family:var(--font-heading-family,'Syne',sans-serif);font-size:clamp(34px,4vw,58px);font-weight:850;line-height:1;letter-spacing:.01em}
  .dd-textile-banner__description{max-width:330px;margin-top:14px;color:rgba(255,255,255,.9);font-size:14px;line-height:1.55}
  .dd-textile-banner__action{display:flex;align-items:center;justify-content:space-between;gap:18px;width:100%;margin-top:26px;font-size:11px;font-weight:850;letter-spacing:.13em}
  .dd-textile-banner__action i{display:grid;width:44px;height:44px;place-items:center;border:1px solid rgba(255,255,255,.8);border-radius:50%;font-size:18px;font-style:normal;transition:background .2s,color .2s,transform .2s}
  .dd-textile-banner:hover .dd-textile-banner__action i{transform:translateX(3px);background:#fff;color:#64182b}
  @media(max-width:900px){.dd-textile-banners{gap:14px}.dd-textile-banner{min-height:460px;border-radius:23px}.dd-textile-banner__copy{right:19px;bottom:20px;left:19px}.dd-textile-banner__number{top:18px;left:18px}.dd-textile-banner__description{font-size:13px}}
  @media(max-width:680px){.dd-textile-landing{padding:25px 15px 32px}.dd-textile-landing h1{font-size:clamp(27px,8vw,42px);margin-bottom:20px}.dd-textile-banners{grid-template-columns:1fr;gap:15px;max-width:500px;margin:0 auto}.dd-textile-banner{min-height:0;aspect-ratio:1.08;border-radius:20px}.dd-textile-banner__copy{right:22px;bottom:22px;left:22px}.dd-textile-banner__copy strong{font-size:40px}}
  @media(prefers-reduced-motion:reduce){.dd-textile-banner,.dd-textile-banner>img,.dd-textile-banner__action i{transition:none}}
</style>

{% schema %}
{
  "name": "DEEDAP Textiles",
  "tag": "section",
  "class": "section-deedap-textiles",
  "settings": [
    { "type": "collection", "id": "men_collection", "label": "Men collection" },
    { "type": "collection", "id": "women_collection", "label": "Women collection" },
    { "type": "collection", "id": "kids_collection", "label": "Kids collection" }
  ],
  "presets": [
    { "name": "DEEDAP Textiles" }
  ]
}
{% endschema %}