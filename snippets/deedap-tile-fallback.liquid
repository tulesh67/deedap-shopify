  assign target_handle = title | handleize
  if target_handle contains 'shirt'
    if all_products['handloom-cotton-shirt'] != empty
      assign target_handle = 'handloom-cotton-shirt'
    elsif all_products['shirt'] != empty
      assign target_handle = 'shirt'
    endif
  endif

  assign target_prod = all_products[target_handle]
  assign fallback_variant_id = ''
  if target_prod != empty and target_prod.id != blank
    assign product_url = target_prod.url
    assign fallback_variant_id = target_prod.selected_or_first_available_variant.id
  else
    for prod in collections['all'].products
      if prod.available and prod.selected_or_first_available_variant.id != blank
        assign fallback_variant_id = prod.selected_or_first_available_variant.id
        break
      endif
    endfor
    if target_handle contains 'shirt' and all_products['shirt'] != empty
      assign product_url = all_products['shirt'].url
    endif
  endif
-%}

<article
  class="dd-sq"
  data-qv-trigger="true"
  data-title="{{ title | escape }}"
  data-price="{{ price_money }}"
  data-category="{{ cat_handle | default: 'Curated Collection' | replace: '-', ' ' | capitalize | escape }}"
  data-color="{{ cat_color | default: '#96752C' }}"
  data-description="Verified physical discovery inspected for structural fidelity, craftsmanship authenticity, and daily wear durability."
  data-image="{{ img_url }}"
  data-variant-id="{{ fallback_variant_id }}"
  data-product-url="{{ product_url }}"
  style="cursor: pointer;"
>
  <div class="dd-sqimg dd-stripe" style="background:{{ tint_color }}">
    <a class="dd-sq-link" href="{{ product_url }}" tabindex="-1" aria-hidden="true" data-qv-trigger="true">
      <span class="dd-zoom">
        {%- if img_url != blank -%}
          <img src="{{ img_url }}" loading="lazy" width="300" height="300" alt="{{ title | escape }}" style="width:100%;height:100%;object-fit:cover;display:block">
        {%- else -%}
          <span class="dd-ph"></span>
        {%- endif -%}
      </span>
    </a>
    {%- if auto_tag != blank -%}<span class="dd-pill">{{ auto_tag }}</span>{%- endif -%}
    <button
      class="dd-addb dd-sqadd"
      type="button"
      data-dd-add
      data-variant-id="{{ fallback_variant_id }}"
      data-product-url="{{ product_url }}"
      aria-label="Add {{ title | escape }} to bag"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
    </button>
  </div>
  <div class="dd-sq-body">
    {%- if show_cat and cat_label != blank -%}
      <div class="dd-sq-cat"><i style="background:{{ cat_color | default: '#B8923F' }}"></i><span>{{ cat_label }}</span></div>
    {%- endif -%}
    <h3><a href="{{ product_url }}" data-qv-trigger="true" style="color:inherit;text-decoration:none">{{ title }}</a></h3>
    <div class="dd-price">
      {{ price_money }}
      {%- if compare_money != blank -%}<s>{{ compare_money }}</s>{%- endif -%}
    </div>
  </div>
</article>
