{% render 'deedap-assets' %}

{%- if section.blocks.size > 0 -%}
<div class="dd-na dd-ann" role="region" aria-label="{{ section.settings.aria_label | escape }}" style="--dd-ann-s:{{ section.settings.speed }}s">
  <div class="dd-ann-m">
    <div class="dd-ann-t">
      {%- for copy in (1..2) -%}
        <div class="dd-ann-g"{% if copy == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <span class="dd-ann-i" {{ block.shopify_attributes }}>
              <svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true"><path d="M5 0l1.4 3.6L10 5 6.4 6.4 5 10 3.6 6.4 0 5l3.6-1.4z" fill="#E8C875"/></svg>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}"{% if copy == 2 %} tabindex="-1"{% endif %}>{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Deedap · Announcement bar",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessibility label", "default": "Announcements" },
    { "type": "range", "id": "speed", "label": "Scroll duration (seconds, higher = slower)", "min": 15, "max": 90, "step": 1, "default": 38 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Complimentary inspected courier over $75" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Deedap · Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Deedap sourcing: verified physical retail & wholesale discoveries" } },
        { "type": "message", "settings": { "text": "Complimentary inspected courier over $75" } },
        { "type": "message", "settings": { "text": "New arrivals added every week" } },
        { "type": "message", "settings": { "text": "Direct-to-consumer quality" } }
      ]
    }
  ]
}
{% endschema %}
