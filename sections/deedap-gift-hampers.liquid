<section class="dd-gh" aria-labelledby="dd-gh-title">
  <div class="dd-gh__intro">
    <p class="dd-gh__eyebrow">A LITTLE JOY, BEAUTIFULLY BOXED</p>
    <h1 id="dd-gh-title">Gifts that feel <em>like a celebration.</em></h1>
    <p class="dd-gh__lead">Thoughtful festive hampers, ready to make someone’s day. Choose the box that feels just right.</p>
    <div class="dd-gh__assurance"><span>✦ Festive ready</span><span>✦ Thoughtfully packed</span><span>✦ Made for sharing</span></div>
  </div>

  <div class="dd-gh__products" aria-label="Gift hamper options">
    <article class="dd-gh-card">
      <a class="dd-gh-card__image" href="/pages/contact" aria-label="Enquire about hamper with brass diya">
        <img src="{{ 'gift-hamper-diya.jpg' | asset_url }}" alt="Festive gift hamper with four jars and a decorative brass diya" width="1536" height="1024" fetchpriority="high">
        <span class="dd-gh-card__number">OPTION 01</span>
      </a>
      <div class="dd-gh-card__body">
        <p class="dd-gh-card__type">THE FESTIVE FAVOURITE</p>
        <h2>Hamper with Brass Diya</h2>
        <p class="dd-gh-card__description">A colourful festive gift box, paired with a decorative brass diya.</p>
        <div class="dd-gh-card__foot"><strong>₹350<span>/-</span></strong><a href="/pages/contact">Enquire <span aria-hidden="true">↗</span></a></div>
      </div>
    </article>

    <article class="dd-gh-card dd-gh-card--featured">
      <a class="dd-gh-card__image" href="/pages/contact" aria-label="Enquire about hamper with 100 gram cashews">
        <img src="{{ 'gift-hamper-cashews.png' | asset_url }}" alt="Festive gift hamper with four jars and a gift box" width="1536" height="1024" loading="lazy">
        <span class="dd-gh-card__number">OPTION 02</span>
        <span class="dd-gh-card__ribbon">A THOUGHTFUL EXTRA</span>
      </a>
      <div class="dd-gh-card__body">
        <p class="dd-gh-card__type">THE SHARING BOX</p>
        <h2>Hamper with 100 g Cashews</h2>
        <p class="dd-gh-card__description">A colourful festive gift box, with 100 g of cashews to share.</p>
        <div class="dd-gh-card__foot"><strong>₹365<span>/-</span></strong><a href="/pages/contact">Enquire <span aria-hidden="true">↗</span></a></div>
      </div>
    </article>

    <article class="dd-gh-card">
      <a class="dd-gh-card__image" href="/pages/contact" aria-label="Enquire about the festive gift hamper">
        <img src="{{ 'gift-hamper-festive.png' | asset_url }}" alt="A selection of colourful festive gift hamper boxes" width="906" height="600" loading="lazy">
        <span class="dd-gh-card__number">OPTION 03</span>
      </a>
      <div class="dd-gh-card__body">
        <p class="dd-gh-card__type">THE JOYFUL GESTURE</p>
        <h2>Festive Gift Hamper</h2>
        <p class="dd-gh-card__description">A bright, ready-to-gift festive box for sharing a little joy.</p>
        <div class="dd-gh-card__foot"><strong>₹250<span>/-</span></strong><a href="/pages/contact">Enquire <span aria-hidden="true">↗</span></a></div>
      </div>
    </article>
  </div>

  <footer class="dd-gh__footer"><span>THE DEEDAP FESTIVE EDIT</span><a href="/">CONTINUE EXPLORING DEEDAP ↑</a></footer>
</section>

<style>
  .dd-gh{--gh-ink:#281b16;--gh-wine:#64182b;--gh-gold:#bd8a36;--gh-cream:#fbf6eb;color:var(--gh-ink);background:var(--gh-cream);padding:clamp(32px,4vw,58px) max(22px,calc((100vw - 1320px)/2)) 24px;font-family:var(--font-body-family,inherit)}
  .dd-gh__intro{text-align:center;max-width:1320px;margin:0 auto 32px}.dd-gh__eyebrow,.dd-gh-card__type{font-size:11px;font-weight:800;letter-spacing:.2em;color:var(--gh-gold)}.dd-gh__eyebrow{margin:0 0 10px}.dd-gh__intro h1{font-family:var(--font-heading-family,Georgia,serif);font-size:clamp(28px,3.5vw,46px);line-height:1.12;letter-spacing:-.045em;margin:0 auto;color:var(--gh-wine);white-space:nowrap}.dd-gh__intro h1 em{display:inline;font-weight:500;color:var(--gh-ink)}.dd-gh__lead{max-width:none;margin:12px auto 16px;font-size:15px;line-height:1.5;color:#6f6258;white-space:nowrap}.dd-gh__assurance{display:flex;justify-content:center;gap:22px;flex-wrap:wrap;font-size:12px;font-weight:700;letter-spacing:.04em;color:#76552c}
  .dd-gh__products{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;align-items:stretch}.dd-gh-card{background:#fff;border:1px solid rgba(100,24,43,.1);border-radius:18px;overflow:hidden;box-shadow:0 12px 36px rgba(49,30,15,.08);transition:transform .25s ease,box-shadow .25s ease}.dd-gh-card:hover{transform:translateY(-5px);box-shadow:0 20px 48px rgba(49,30,15,.14)}.dd-gh-card--featured{border-color:rgba(189,138,54,.65);box-shadow:0 16px 42px rgba(100,24,43,.14)}.dd-gh-card__image{display:block;position:relative;aspect-ratio:1.12;background:#eee7dc;overflow:hidden}.dd-gh-card__image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .5s ease}.dd-gh-card:hover .dd-gh-card__image img{transform:scale(1.035)}.dd-gh-card__number{position:absolute;top:15px;left:15px;padding:9px 12px;border-radius:999px;background:rgba(255,252,244,.95);color:var(--gh-wine);font-size:10px;font-weight:900;letter-spacing:.13em}.dd-gh-card__ribbon{position:absolute;right:14px;top:15px;padding:9px 11px;border-radius:3px;background:var(--gh-wine);color:white;font-size:9px;font-weight:800;letter-spacing:.1em}.dd-gh-card__body{padding:22px 23px 20px}.dd-gh-card__type{margin:0 0 9px;font-size:9px}.dd-gh-card h2{margin:0;color:var(--gh-ink);font-family:var(--font-heading-family,Georgia,serif);font-size:24px;line-height:1.18}.dd-gh-card__description{min-height:48px;margin:10px 0 19px;color:#71655d;font-size:13px;line-height:1.55}.dd-gh-card__foot{border-top:1px solid #eee8df;padding-top:16px;display:flex;align-items:center;justify-content:space-between;gap:12px}.dd-gh-card__foot strong{font-size:27px;color:var(--gh-wine);letter-spacing:-.04em}.dd-gh-card__foot strong span{font-size:14px;font-weight:600}.dd-gh-card__foot a{display:inline-flex;align-items:center;gap:12px;padding:11px 15px;border-radius:999px;background:var(--gh-wine);color:#fff;text-decoration:none;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.dd-gh-card__foot a:hover{background:#481020}.dd-gh__footer{max-width:1320px;margin:42px auto 0;padding-top:18px;border-top:1px solid rgba(100,24,43,.18);display:flex;justify-content:space-between;gap:15px;color:#876e5d;font-size:10px;font-weight:800;letter-spacing:.13em}.dd-gh__footer a{color:var(--gh-wine);text-decoration:none}
  @media(max-width:900px){.dd-gh__products{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.dd-gh-card__body{padding:18px}.dd-gh-card h2{font-size:21px}}
  @media(max-width:600px){.dd-gh{padding:34px 16px 22px}.dd-gh__intro{margin-bottom:26px}.dd-gh__intro h1{font-size:clamp(20px,5.7vw,34px);letter-spacing:-.055em}.dd-gh__lead{font-size:clamp(10px,2.6vw,14px)}.dd-gh__assurance{gap:9px 16px;font-size:10px}.dd-gh__products{grid-template-columns:1fr;max-width:430px}.dd-gh-card__image{aspect-ratio:1.18}.dd-gh-card__description{min-height:0}.dd-gh__footer{font-size:9px;letter-spacing:.07em}}
</style>

