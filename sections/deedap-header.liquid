{% render 'deedap-assets' %}

{%- liquid
  assign menu = linklists[section.settings.menu]
-%}

<style>
  .dd-header-section,
  header.dd-header-section {
    position: sticky !important;
    top: 0 !important;
    z-index: 1000 !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
    background: #F7F1E3 !important;
  }
  .dd-na,
  header.dd-na {
    position: static !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #F7F1E3 !important;
  }
  .dd-nav2 {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 0 !important;
    background: #ffffff !important;
    box-sizing: border-box !important;
  }

  /* ==============================================================
     TOP ROW: LOGO ON LEFT, SEARCH BAR & CART/ACCOUNT IN RIGHT CORNER
     ============================================================== */
  .dd-nav2-top {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
    max-width: 100% !important;
    min-height: 84px !important;
    padding: 8px 32px 7px !important;
    box-sizing: border-box !important;
    gap: 20px !important;
    background: #F7F1E3 !important;
    border-bottom: 1px solid rgba(20, 17, 12, 0.06) !important;
  }

  .dd-logo-wrap {
    display: inline-flex !important;
    align-items: center !important;
    flex-shrink: 0 !important;
    width: 190px !important;
    height: auto !important;
    font-size: 26px !important;
    letter-spacing: 0.3em !important;
    font-weight: 700 !important;
    color: #14110C !important;
    text-decoration: none !important;
    font-family: 'Syne', serif, system-ui !important;
  }

  .dd-logo-image {
    display: block !important;
    width: 100% !important;
    height: auto !important;
  }

  /* Right corner group: Search Bar + Account + Bag */
  .dd-top-right-corner {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 12px !important;
    flex-shrink: 0 !important;
  }

  /* Sleek search bar placed in the right corner */
  .dd-nsearch-corner {
    position: relative !important;
    width: clamp(200px, 22vw, 320px) !important;
    display: flex !important;
    align-items: center !important;
  }

  .dd-nsearch-corner input {
    width: 100% !important;
    height: 36px !important;
    padding: 0 16px 0 38px !important;
    border-radius: 999px !important;
    border: 1.5px solid rgba(20, 17, 12, 0.14) !important;
    background: #FDFBF7 !important;
    font-size: 13px !important;
    font-family: 'Manrope', system-ui, sans-serif !important;
    color: #14110C !important;
    outline: none !important;
    transition: all 0.2s ease !important;
    box-sizing: border-box !important;
  }

  .dd-nsearch-corner input:focus {
    border-color: #B8923F !important;
    background: #ffffff !important;
    box-shadow: 0 0 0 3px rgba(184, 146, 63, 0.15) !important;
  }

  .dd-nsearch-corner svg {
    position: absolute !important;
    left: 13px !important;
    pointer-events: none !important;
    width: 15px !important;
    height: 15px !important;
  }

  .dd-bagb {
    height: 36px !important;
    padding: 0 16px !important;
    font-size: 12px !important;
    font-weight: 800 !important;
    border-radius: 999px !important;
    background: #14110C !important;
    color: #ffffff !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 7px !important;
    text-decoration: none !important;
    letter-spacing: 0.08em !important;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15) !important;
    transition: transform 0.2s, background 0.2s !important;
    flex-shrink: 0 !important;
  }
  .dd-bagb:hover {
    background: #2A241C !important;
    transform: translateY(-1px) !important;
  }

  .dd-bagb span {
    background: #F5C451 !important;
    color: #14110C !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    padding: 1px 7px !important;
    border-radius: 999px !important;
  }

  .dd-nico {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 36px !important;
    height: 36px !important;
    color: #14110C !important;
    text-decoration: none !important;
    border-radius: 50% !important;
    transition: background 0.2s !important;
    flex-shrink: 0 !important;
  }
  .dd-nico:hover {
    background: #F5F3ED !important;
  }

  /* ==============================================================
     FLIPKART CATEGORY BAR: BOLD LETTERS, VISIBLE GAPS, PROMINENT ICONS
     ============================================================== */
  .dd-fk-cat-bar {
    width: 100% !important;
    background: #ffffff !important;
    border-bottom: 1px solid #E6E6E6 !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04) !important;
    box-sizing: border-box !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    -webkit-overflow-scrolling: touch !important;
    scrollbar-width: none !important;
  }

  .dd-fk-cat-bar::-webkit-scrollbar {
    display: none !important;
  }

  .dd-fk-cat-list {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
    padding: 8px 32px 10px !important;
    list-style: none !important;
    gap: clamp(16px, 2.6vw, 42px) !important;
    box-sizing: border-box !important;
    min-width: max-content !important;
  }

  .dd-fk-cat-item {
    display: inline-flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    gap: 6px !important;
    padding: 4px 8px 6px !important;
    cursor: pointer !important;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.2s ease !important;
    flex-shrink: 0 !important;
    position: relative !important;
  }

  .dd-fk-cat-item:hover {
    transform: translateY(-2px) !important;
  }

  /* Prominent Flipkart Style Two-Tone Icons: 28x28 */
  .dd-fk-cat-icon {
    width: 28px !important;
    height: 28px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    position: relative !important;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
  }

  .dd-fk-cat-item:hover .dd-fk-cat-icon {
    transform: scale(1.12) !important;
  }

  .dd-fk-cat-icon svg {
    width: 28px !important;
    height: 28px !important;
    display: block !important;
  }

  /* BOLD AND CLEARLY VISIBLE LABELS */
  .dd-fk-cat-label {
    font-size: 13px !important;
    font-weight: 800 !important;
    color: #14110C !important;
    text-align: center !important;
    white-space: nowrap !important;
    letter-spacing: -0.01em !important;
    transition: color 0.2s ease !important;
    font-family: 'Manrope', system-ui, sans-serif !important;
    line-height: 1.2 !important;
  }

  .dd-fk-cat-item:hover .dd-fk-cat-label {
    color: #8A6416 !important;
  }

  .dd-fk-cat-item.active .dd-fk-cat-label {
    color: #8A6416 !important;
  }

  .dd-fk-cat-item.active::after {
    content: '' !important;
    position: absolute !important;
    bottom: 0 !important;
    left: 10% !important;
    right: 10% !important;
    height: 2.5px !important;
    background: #F5C451 !important;
    border-radius: 999px !important;
  }

  @media (max-width: 900px) {
    .dd-nav2-top {
      padding: 8px 16px !important;
      gap: 12px !important;
    }
    .dd-logo-wrap {
      width: 145px !important;
      font-size: 20px !important;
    }
    .dd-nsearch-corner {
      width: 180px !important;
    }
    .dd-nsearch-corner input {
      height: 32px !important;
      font-size: 12px !important;
    }
    .dd-fk-cat-list {
      justify-content: flex-start !important;
      gap: 20px !important;
      padding: 8px 16px 10px !important;
    }
    .dd-fk-cat-label {
      font-size: 12px !important;
    }
  }
</style>

<header class="dd-na" role="banner">
  <nav class="dd-nav2" aria-label="Primary">
    <!-- TOP ROW: Logo on Left, Search Bar & Bag in Right Corner -->
    <div class="dd-nav2-top">
      <a href="{{ routes.root_url }}" class="dd-serif dd-logo dd-logo-wrap">
        <img src="{{ 'deedap-logo-maroon.png' | asset_url }}" alt="{{ shop.name | escape }}" class="dd-logo-image" width="1366" height="488" fetchpriority="high">
      </a>

      <!-- Right Corner Controls: Search Bar + Account + Bag -->
      <div class="dd-top-right-corner">
        <form class="dd-nsearch-corner" action="{{ routes.search_url }}" method="get" role="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="#7A5710" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
          <label class="dd-visually-hidden" for="dd-search-{{ section.id }}">Search</label>
          <input id="dd-search-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off">
        </form>

        <a href="{{ routes.account_url }}" class="dd-nico" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1-4 4-6 8-6s7 2 8 6"></path></svg>
        </a>
        {%- if section.settings.wishlist_url != blank -%}
          <a href="{{ section.settings.wishlist_url }}" class="dd-nico" aria-label="Wishlist">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-4.6-9.3-9.2C1.2 8.6 3 5 6.5 5c2 0 3.6 1.1 5.5 3 1.9-1.9 3.5-3 5.5-3C21 5 22.8 8.6 21.3 11.8 19 16.4 12 21 12 21z"></path></svg>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="dd-bagb" aria-label="Bag, {{ cart.item_count }} items">BAG<span data-dd-cart-count>{{ cart.item_count }}</span></a>
      </div>
    </div>

    <!-- FLIPKART-STYLE CATEGORY NAVIGATION BAR (BOLD LABELS & VISIBLE GAPS) -->
    {%- if section.settings.show_categories -%}
      <div class="dd-fk-cat-bar" role="navigation" aria-label="Departments">
        <ul class="dd-fk-cat-list">
          
          <!-- 1. Clothing & Textiles -->
          <li>
            <a class="dd-fk-cat-item" href="/pages/textiles">
              <span class="dd-fk-cat-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 6L6 10L10 13L10 26L22 26L22 13L26 10L22 6C20 8 18 9 16 9C14 9 12 8 10 6Z" stroke="#14110C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M10 21L22 21L22 26L10 26Z" fill="#F5C451" stroke="#14110C" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="dd-fk-cat-label">Clothing &amp; Textiles</span>
            </a>
          </li>

          <!-- 2. Information & Technology -->
          <li>
            <a class="dd-fk-cat-item" href="/pages/electronics">
              <span class="dd-fk-cat-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="8" y="5" width="16" height="22" rx="3" stroke="#14110C" stroke-width="1.8"/>
                  <rect x="10.5" y="8" width="11" height="12" rx="1" fill="#FFEAA8" stroke="#14110C" stroke-width="1.2"/>
                  <circle cx="16" cy="23.5" r="1.3" fill="#F5C451"/>
                  <line x1="13" y1="6.5" x2="19" y2="6.5" stroke="#14110C" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="dd-fk-cat-label">Information &amp; Tech</span>
            </a>
          </li>

          <!-- 3. Organic & Natural Products -->
          <li>
            <a class="dd-fk-cat-item" href="/pages/organic-natural">
              <span class="dd-fk-cat-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="11" y="5" width="10" height="4" rx="1" stroke="#14110C" stroke-width="1.8"/>
                  <path d="M8 9H24V22C24 24.5 22 26.5 19.5 26.5H12.5C10 26.5 8 24.5 8 22V9Z" stroke="#14110C" stroke-width="1.8" stroke-linejoin="round"/>
                  <rect x="9.5" y="13.5" width="13" height="7.5" rx="1.5" fill="#F5C451" stroke="#14110C" stroke-width="1.4"/>
                </svg>
              </span>
              <span class="dd-fk-cat-label">Organic &amp; Natural</span>
            </a>
          </li>

          <!-- 4. Global Collections -->
          <li>
            <a class="dd-fk-cat-item" href="/#row-global-collections">
              <span class="dd-fk-cat-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="16" cy="16" r="10.5" stroke="#14110C" stroke-width="1.8"/>
                  <ellipse cx="16" cy="16" rx="5" ry="10.5" fill="#FFEAA8" stroke="#14110C" stroke-width="1.4"/>
                  <line x1="5.5" y1="16" x2="26.5" y2="16" stroke="#14110C" stroke-width="1.6"/>
                  <circle cx="16" cy="16" r="2.5" fill="#F5C451"/>
                </svg>
              </span>
              <span class="dd-fk-cat-label">Global Collections</span>
            </a>
          </li>

          <!-- 5. Essentials / Living -->
          <li>
            <a class="dd-fk-cat-item" href="/#row-essentials">
              <span class="dd-fk-cat-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11 6L21 6L24 16L8 16L11 6Z" fill="#F5C451" stroke="#14110C" stroke-width="1.8" stroke-linejoin="round"/>
                  <line x1="16" y1="16" x2="16" y2="25" stroke="#14110C" stroke-width="1.8"/>
                  <line x1="11" y1="25" x2="21" y2="25" stroke="#14110C" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="dd-fk-cat-label">Essentials</span>
            </a>
          </li>

          <!-- 6. Jewellery -->
          <li>
            <a class="dd-fk-cat-item" href="/pages/jewelry">
              <span class="dd-fk-cat-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 7L22 7L27 13L16 26L5 13L10 7Z" stroke="#14110C" stroke-width="1.8" stroke-linejoin="round"/>
                  <polygon points="10,7 22,7 19,13 13,13" fill="#F5C451" stroke="#14110C" stroke-width="1.2"/>
                  <line x1="5" y1="13" x2="27" y2="13" stroke="#14110C" stroke-width="1.4"/>
                  <line x1="16" y1="26" x2="13" y2="13" stroke="#14110C" stroke-width="1.2"/>
                  <line x1="16" y1="26" x2="19" y2="13" stroke="#14110C" stroke-width="1.2"/>
                </svg>
              </span>
              <span class="dd-fk-cat-label">Jewellery</span>
            </a>
          </li>

          <!-- 7. Cookware -->
          <li>
            <a class="dd-fk-cat-item" href="/pages/cookware">
              <span class="dd-fk-cat-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="16" cy="8" r="1.8" fill="#F5C451" stroke="#14110C" stroke-width="1.4"/>
                  <path d="M9 12C12 10.5 20 10.5 23 12" stroke="#14110C" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M7 13H25V20C25 23 23 25.5 19 25.5H13C9 25.5 7 23 7 20V13Z" stroke="#14110C" stroke-width="1.8"/>
                  <rect x="7" y="13" width="18" height="3" fill="#F5C451" stroke="#14110C" stroke-width="1.2"/>
                  <path d="M7 16H4" stroke="#14110C" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M25 16H28" stroke="#14110C" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="dd-fk-cat-label">Cookware</span>
            </a>
          </li>

          <!-- 8. Gift Hampers -->
          <li>
            <a class="dd-fk-cat-item" href="/pages/gift-hampers">
              <span class="dd-fk-cat-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="6.5" y="13" width="19" height="13" rx="1.5" stroke="#14110C" stroke-width="1.8"/>
                  <rect x="5" y="9" width="22" height="4" rx="1" fill="#FFEAA8" stroke="#14110C" stroke-width="1.6"/>
                  <rect x="14" y="9" width="4" height="17" fill="#F5C451" stroke="#14110C" stroke-width="1.4"/>
                  <path d="M12 6.5C12 4.5 14 4.5 16 7C18 4.5 20 4.5 20 6.5C20 8.5 17 9 16 9C15 9 12 8.5 12 6.5Z" fill="#F5C451" stroke="#14110C" stroke-width="1.2"/>
                </svg>
              </span>
              <span class="dd-fk-cat-label">Gift Hampers</span>
            </a>
          </li>

          <!-- 9. Carryout Bags -->
          <li>
            <a class="dd-fk-cat-item" href="/pages/carryout-bags">
              <span class="dd-fk-cat-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7 10L9 26C9 27.1 9.9 28 11 28H21C22.1 28 23 27.1 23 26L25 10H7Z" stroke="#14110C" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M11 14C11 17 13 18.5 16 18.5C19 18.5 21 17 21 14" fill="#F5C451" stroke="#14110C" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="dd-fk-cat-label">Carryout Bags</span>
            </a>
          </li>

          <!-- 10. Accessories -->
          <li>
            <a class="dd-fk-cat-item" href="/pages/accessories">
              <span class="dd-fk-cat-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="12" y="4" width="8" height="4" rx="1" fill="#FFEAA8" stroke="#14110C" stroke-width="1.4"/>
                  <rect x="12" y="24" width="8" height="4" rx="1" fill="#FFEAA8" stroke="#14110C" stroke-width="1.4"/>
                  <circle cx="16" cy="16" r="8" fill="#F5C451" stroke="#14110C" stroke-width="1.8"/>
                  <circle cx="16" cy="16" r="5.5" fill="#FFFFFF" stroke="#14110C" stroke-width="1.2"/>
                  <polyline points="16,13 16,16 18,17" stroke="#14110C" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="dd-fk-cat-label">Accessories</span>
            </a>
          </li>

        </ul>
      </div>
    {%- endif -%}
  </nav>
</header>

{% schema %}
{
  "name": "Deedap Header",
  "tag": "header",
  "class": "dd-header-section",
  "settings": [
    { "type": "checkbox", "id": "show_categories", "label": "Show Flipkart category navigation bar", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)" },
    { "type": "text", "id": "logo_text", "label": "Logo text (used when no image)", "default": "Deedap" },
    { "type": "link_list", "id": "menu", "label": "Category menu", "default": "main-menu" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search jewellery, textiles, tech…" },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist link (leave empty to hide the heart)" }
  ]
}
{% endschema %}
