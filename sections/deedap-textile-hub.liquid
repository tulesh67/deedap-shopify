.deedap-textile-page a { color: inherit; text-decoration: none; }
.deedap-textile-page * { box-sizing: border-box; }
@property --ang{syntax:'<angle>';inherits:false;initial-value:0deg}
.disp{font-family:'Syne',sans-serif;font-weight:800;text-transform:uppercase}

/* ============ CURTAIN INTRO ============ */
.curtain{display:none!important;visibility:hidden!important}
@keyframes gone{to{visibility:hidden}}
.cT,.cB{position:absolute;left:0;width:100%;height:50%;background:#0f1014}
.cT{top:0;animation:cTop 1s cubic-bezier(.77,0,.18,1) 1.7s forwards}
.cB{bottom:0;animation:cBot 1s cubic-bezier(.77,0,.18,1) 1.7s forwards}
@keyframes cTop{to{transform:translateY(-101%)}}
@keyframes cBot{to{transform:translateY(101%)}}
.cWord{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:clamp(40px,10vw,150px);letter-spacing:.04em;color:#fbfaf8;animation:cWord 1.7s cubic-bezier(.2,.8,.2,1) forwards}
.cWord span{display:inline-block;animation:cLet 1.1s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i)*.08s)}
@keyframes cLet{from{opacity:0;transform:translateY(80px) rotate(12deg)}to{opacity:1;transform:none}}
@keyframes cWord{0%,80%{opacity:1}100%{opacity:0;transform:scale(1.4)}}
.cLine{position:absolute;left:0;top:50%;height:2px;width:100%;background:#b8923a;transform:scaleX(0);animation:cLine 1.6s cubic-bezier(.7,0,.2,1) .2s forwards;z-index:2}
@keyframes cLine{0%{transform:scaleX(0)}60%{transform:scaleX(1);opacity:1}100%{transform:scaleX(1);opacity:0}}

/* ============ HERO ============ */
.blob{position:absolute;border-radius:50%;filter:blur(70px);will-change:transform}
.b1{width:620px;height:620px;left:-8%;top:-12%;background:radial-gradient(circle,#ecd9b4,rgba(236,217,180,0) 70%);animation:bl1 11s ease-in-out infinite}
.b2{width:700px;height:700px;right:-10%;top:10%;background:radial-gradient(circle,#e6c98a,rgba(230,201,138,0) 70%);animation:bl2 14s ease-in-out infinite}
.b3{width:520px;height:520px;left:35%;bottom:-20%;background:radial-gradient(circle,#d2bd96,rgba(210,189,150,0) 70%);animation:bl1 17s ease-in-out infinite reverse;opacity:.7}
@keyframes bl1{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(160px,90px) scale(1.25)}}
@keyframes bl2{0%,100%{transform:translate(0,0) scale(1.1)}50%{transform:translate(-180px,70px) scale(.85)}}
.gridbg{position:absolute;inset:0;background-image:linear-gradient(rgba(122,92,31,.13) 1px,transparent 1px),linear-gradient(90deg,rgba(122,92,31,.13) 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse at 50% 40%,#000 0%,transparent 72%);mask-image:radial-gradient(ellipse at 50% 40%,#000 0%,transparent 72%);animation:gridmove 6s linear infinite}
@keyframes gridmove{to{background-position:0 56px,56px 0}}
.thread{fill:none;stroke-width:2.5;stroke-linecap:round;stroke-dasharray:.22 .78;animation:flow 6s linear infinite}
.thread.t2{animation-duration:9s;stroke-width:1.5}
.thread.t3{animation-duration:7.5s;animation-direction:reverse}
@keyframes flow{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}

.l{display:inline-block;transform-origin:50% 100%;animation:letIn 1s cubic-bezier(.2,1.2,.3,1) both,wave 3.2s ease-in-out infinite;animation-delay:calc(2.1s + var(--i)*.06s),calc(3.4s + var(--i)*.13s)}
@keyframes letIn{from{opacity:0;transform:translateY(120px) rotateX(-90deg) scale(.6)}to{opacity:1;transform:none}}
@keyframes wave{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-14px) rotate(-2deg)}}
.c-w{color:#0f1014}
.c-o{color:#3a2f1e}
.c-g{background:linear-gradient(180deg,#8a6a2a 0%,#b8923a 55%,#c9a24d 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
.c-g.l{filter:drop-shadow(0 0 22px rgba(122,92,31,.35))}

.pop{opacity:1;transform:translateY(30px);animation:pop .9s cubic-bezier(.2,.8,.2,1) forwards;animation-delay:calc(2.6s + var(--k,0)*.2s)}
@keyframes pop{to{opacity:1;transform:none}}
.glowdot{animation:blink 1.6s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(184,146,58,.55)}50%{opacity:.6;box-shadow:0 0 0 12px rgba(184,146,58,0)}}

/* 3D fabric ring */
.scene{perspective:1500px;width:100%;height:600px;display:flex;align-items:center;justify-content:center;position:relative}
.ring{position:relative;width:0;height:0;transform-style:preserve-3d;animation:ringspin 20s linear infinite,ringIn 2s cubic-bezier(.2,.8,.2,1) 2.2s both}
@keyframes ringspin{from{transform:rotateX(-16deg) rotateY(0)}to{transform:rotateX(-16deg) rotateY(360deg)}}
@keyframes ringIn{from{opacity:0;scale:.2}to{opacity:1;scale:1}}
.scene:hover .ring{animation-duration:60s,2s}
.pnl{position:absolute;left:-80px;top:-125px;width:160px;height:250px;border-radius:18px;overflow:hidden;transform:rotateY(calc(var(--n)*36deg)) translateZ(var(--r,380px));box-shadow:0 0 0 1px rgba(122,92,31,.25),0 30px 60px rgba(122,92,31,.3);backface-visibility:visible}
.pnl::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.2) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.2) 1px,transparent 1px);background-size:20px 20px;mix-blend-mode:overlay;animation:gridmove 4s linear infinite}
.pnl::before{content:"";position:absolute;top:-20%;left:-60%;width:50%;height:140%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.5),transparent);transform:rotate(15deg);animation:pshine 4s ease-in-out infinite;animation-delay:calc(var(--n)*.4s);z-index:1}
@keyframes pshine{0%,60%{left:-60%}100%{left:130%}}
.floor{position:absolute;left:50%;bottom:30px;width:520px;height:90px;margin-left:-260px;border-radius:50%;background:radial-gradient(ellipse,rgba(184,146,58,.4),rgba(184,146,58,0) 70%);animation:floorp 4s ease-in-out infinite}
@keyframes floorp{0%,100%{transform:scale(1);opacity:.6}50%{transform:scale(1.25);opacity:1}}
.core{position:absolute;left:50%;top:50%;width:200px;height:200px;margin:-100px 0 0 -100px;border-radius:50%;background:radial-gradient(circle,rgba(184,146,58,.55),rgba(184,146,58,0) 70%);filter:blur(10px);animation:floorp 3s ease-in-out infinite}

/* buttons */
.btn{position:relative;overflow:hidden;transition:transform .3s,box-shadow .3s}
.btn:hover{transform:translateY(-4px) scale(1.04);box-shadow:0 18px 40px rgba(122,92,31,.35)}
.btn::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);transform:translateX(-120%);transition:transform .7s}
.btn:hover::after{transform:translateX(120%)}
.arrow{display:inline-block;transition:transform .3s}
.btn:hover .arrow,.card:hover .arrow{transform:translateX(8px)}
.navlink{position:relative}
.navlink::after{content:"";position:absolute;left:0;bottom:-6px;height:2px;width:100%;background:#b8923a;transform:scaleX(0);transform-origin:left;transition:transform .35s}
.navlink:hover::after{transform:scaleX(1)}

/* ============ GIANT MARQUEES ============ */
.mq{overflow:hidden;white-space:nowrap}
.mtrack{display:flex;width:max-content}
.mtrack..deedap-textile-page a { color: inherit; text-decoration: none; }
.mtrack.b{animation:mq 34s linear infinite reverse}
@keyframes mq{to{transform:translateX(-50%)}}
.mq:hover .mtrack{animation-play-state:paused}
.out{color:transparent;-webkit-text-stroke:2px rgba(251,250,248,.85)}
.mq span.w{padding:0 .35em;font-size:clamp(64px,11vw,170px);line-height:1.05}
.star{display:inline-block;color:#d9b866;animation:spin 6s linear infinite;font-size:clamp(40px,7vw,100px);vertical-align:middle}
@keyframes spin{to{transform:rotate(360deg)}}

/* ============ CARDS ============ */
.wrap{position:relative;flex:1 1 300px;border-radius:32px;padding:2px;background:conic-gradient(from var(--ang),transparent 0 55%,#b8923a 75%,#7a5c1f 90%,transparent 100%);animation:rot 5s linear infinite;transition:transform .6s cubic-bezier(.2,.8,.2,1),filter .4s}
@keyframes rot{to{--ang:360deg}}
.wrap.w1:hover{transform:perspective(1200px) rotateY(10deg) rotateX(4deg) translateY(-16px) scale(1.03)}
.wrap.w2:hover{transform:perspective(1200px) rotateX(8deg) translateY(-20px) scale(1.04)}
.wrap.w3:hover{transform:perspective(1200px) rotateY(-10deg) rotateX(4deg) translateY(-16px) scale(1.03)}
.wrap:hover{filter:drop-shadow(0 30px 50px rgba(122,92,31,.35))}
.card{position:relative;display:flex;flex-direction:column;justify-content:flex-end;min-height:600px;border-radius:30px;overflow:hidden;background:#0c0c10;color:#fbfaf8}
.mesh{position:absolute;border-radius:50%;filter:blur(40px)}
.m-.deedap-textile-page a { color: inherit; text-decoration: none; }
.m-b{animation:bl2 10s ease-in-out infinite}
.bignum{position:absolute;right:-10px;top:10px;font-size:220px;line-height:1;color:transparent;-webkit-text-stroke:2px rgba(255,255,255,.17);z-index:3;transition:transform .8s cubic-bezier(.2,.8,.2,1)}
.card:hover .bignum{transform:translateY(30px) scale(1.15) rotate(-6deg)}
.cardtitle{font-size:clamp(56px,6vw,92px);line-height:.95;transition:letter-spacing .5s,transform .5s}
.textile-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 28%;z-index:0;transition:transform .8s cubic-bezier(.2,.8,.2,1)}
.textile-photo-shade{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(7,8,11,.08) 0%,rgba(7,8,11,.08) 25%,rgba(7,8,11,.56) 58%,rgba(7,8,11,.94) 100%),linear-gradient(90deg,rgba(7,8,11,.2),transparent 76%)}
.card:hover .textile-photo{transform:scale(1.045)}
.textile-photo-kids{object-position:center 0%}
.card .cardtitle{color:#fbfaf8;-webkit-text-fill-color:#fbfaf8;text-shadow:0 3px 26px rgba(0,0,0,.55)}

.card:hover .cardtitle{letter-spacing:.05em;transform:translateX(8px)}
.go{width:56px;height:56px;border-radius:50%;border:1.5px solid #fff;display:flex;align-items:center;justify-content:center;font-size:22px;transition:transform .6s cubic-bezier(.2,.8,.2,1),background .3s,color .3s}
.card:hover .go{transform:rotate(360deg) scale(1.15);background:#fbfaf8;color:#0f1014;border-color:#fbfaf8}
.sheen{position:absolute;top:-10%;left:-70%;width:50%;height:130%;z-index:2;background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);transform:rotate(14deg);animation:sh 5s ease-in-out infinite}
@keyframes sh{0%,55%{left:-70%}100%{left:140%}}

/* ============ SCROLL FILL WORDS ============ */
.fillw{font-size:clamp(70px,14vw,230px);line-height:.98;background:linear-gradient(90deg,#7a5c1f 0%,#b8923a 40%,rgba(15,16,20,.1) 55%);background-size:250% 100%;background-position:0% 0;-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}

/* ============ CTA ============ */
.orb{position:relative;width:240px;height:240px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#0f1014;color:#fbfaf8;font-size:15px;font-weight:800;letter-spacing:.14em;transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s;box-shadow:0 0 80px rgba(122,92,31,.35)}
.orb:hover{transform:scale(1.15) rotate(-6deg);box-shadow:0 0 140px rgba(122,92,31,.35)}
.ripple{position:absolute;left:50%;top:50%;width:240px;height:240px;margin:-120px 0 0 -120px;border-radius:50%;border:2px solid #b8923a;animation:rip 3.6s ease-out infinite;animation-delay:calc(var(--i)*1.2s);opacity:0}
@keyframes rip{0%{transform:scale(1);opacity:.9}100%{transform:scale(3.2);opacity:0}}
.fl{position:absolute;width:var(--s,40px);height:var(--s,40px);border:2px solid #b8923a;transform:rotate(45deg);animation:flt var(--d,9s) ease-in-out infinite;opacity:.6}
.fl.f{background:linear-gradient(135deg,#b8923a,#7a5c1f);border:0;opacity:.85}
@keyframes flt{0%,100%{transform:translateY(0) rotate(45deg)}50%{transform:translateY(-70px) rotate(225deg)}}

/* ============ SCROLL-DRIVEN (Chromium / Brave) ============ */
@supports (animation-timeline: view()){
  .reveal{animation:rev linear both;animation-timeline:view();animation-range:entry 0% entry 60%}
  @keyframes rev{from{opacity:0;transform:translateY(90px) scale(.96)}to{opacity:1;transform:none}}
  .clipin{animation:clipin linear both;animation-timeline:view();animation-range:entry 0% entry 80%}
  @keyframes clipin{from{clip-path:inset(0 0 0 0 round 32px);opacity:.2;transform:translateY(80px) rotate(var(--r0,3deg))}to{clip-path:inset(0 0 0 0 round 32px);opacity:1;transform:none}}
  .fillw{animation:fillscroll linear both;animation-timeline:view();animation-range:entry 20% cover 55%}
  @keyframes fillscroll{from{background-position:100% 0}to{background-position:0% 0}}
  .par{animation:par linear both;animation-timeline:view();animation-range:cover 0% cover 100%}
  @keyframes par{from{transform:translateY(120px)}to{transform:translateY(-120px)}}
  .parx{animation:parx linear both;animation-timeline:view();animation-range:cover 0% cover 100%}
  @keyframes parx{from{transform:translateX(-14%)}to{transform:translateX(14%)}}
  .zoom{animation:zoom linear both;animation-timeline:view();animation-range:entry 0% cover 50%}
  @keyframes zoom{from{transform:scale(.55) rotate(-6deg);opacity:.2}to{transform:none;opacity:1}}
}
@media (max-width:760px){
  .scene{height:420px}
  .ring{scale:.62}
  .mq span.w{font-size:56px}
}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  .curtain{display:none!important;visibility:hidden!important}
  .l,.pop,.ring{opacity:1!important;transform:none!important}
}


/* Ensure 100% immediate visibility on page load - no blank states or hidden overlays */
.curtain { display: none !important; visibility: hidden !important; pointer-events: none !important; }
.pop, .l, .in, .rise, .fadeup, .ringIn, .clipin, .reveal, .mask > span {
  opacity: 1 !important;
  transform: none !important;
  clip-path: none !important;
  visibility: visible !important;
}
.mask { overflow: visible !important; }

