{{ 'jewelry-style.css' | asset_url | stylesheet_tag }}
{% comment %}
  DEEDAP Native Jewellery Landing Page
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">

<section class="deedap-jewelry-page" data-section-id="{{ section.id }}">
  
<div class="dd" style="position:relative;background:#0B0A08;min-height:920px;overflow:hidden;padding-bottom:100px">
  <div class="drift" style="position:absolute;top:-160px;left:-200px;width:720px;height:720px;border-radius:50%;background:radial-gradient(circle,rgba(201,162,75,.20),rgba(201,162,75,0) 65%);pointer-events:none"></div>
  <div class="glow" style="position:absolute;top:80px;right:-120px;width:900px;height:900px;border-radius:50%;background:radial-gradient(circle,rgba(217,182,92,.30),rgba(217,182,92,0) 62%);pointer-events:none"></div>

  <!-- Hero Content -->
  <div class="hc" style="position:relative;z-index:3;max-width:1240px;margin:0 auto;padding:80px 24px 60px;display:flex;flex-wrap:wrap;align-items:center;gap:40px">
    <div style="flex:1 1 500px;min-width:0">
      <div style="display:inline-flex;align-items:center;gap:12px;padding:9px 18px 9px 12px;border-radius:999px;border:1px solid rgba(217,182,92,.4);background:rgba(217,182,92,.08)">
        <span class="pulseDot" style="width:10px;height:10px;border-radius:50%;background:#D9B65C;display:inline-block"></span>
        <span style="font-size:12px;font-weight:800;letter-spacing:.2em;color:#E8C875;text-transform:uppercase">DEEDAP JEWELLERY / THE FINE EDIT</span>
      </div>

      <h1 class="disp" style="margin:28px 0 0;font-size:clamp(44px,6.5vw,92px);line-height:1;letter-spacing:-.01em;color:#F4EEDF">
        <span class="mask"><span class="rise">Made to</span></span><br>
        <span class="mask"><span class="rise">Outshine</span></span><br>
        <span class="mask"><span class="rise goldtxt">Time.</span></span>
      </h1>

      <p style="margin:28px 0 0;max-width:480px;font-size:18px;line-height:1.65;color:#C9BEA6">
        Gold, diamonds and pearls chosen for the moments you keep. Rings, necklaces, earrings and bracelets made to be worn daily, gifted proudly and passed on.
      </p>

      <div style="margin-top:36px;display:flex;flex-wrap:wrap;align-items:center;gap:20px">
        <a class="btn magnet" href="#jewel-gallery" style="display:inline-flex;align-items:center;gap:14px;min-height:56px;padding:0 34px;border-radius:999px;background:linear-gradient(135deg,#F6E2A4,#C9A24B 55%,#A9812F);color:#14110C;text-decoration:none;font-size:13px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">
          Explore the collection &rarr;
        </a>
      </div>
    </div>

    <!-- Featured Showcase Frame -->
    <div style="flex:1 1 440px;min-width:0;position:relative;max-width:540px;margin:0 auto;width:100%">
      <figure class="hfig" style="position:relative;margin:0 auto;width:100%;max-width:480px">
        <div class="hframe" role="img" aria-label="Fine jewelry showcase" style="position:relative;aspect-ratio:4/5;border-radius:240px 240px 28px 28px;overflow:hidden;border:1px solid rgba(217,182,92,.6);box-shadow:0 40px 80px -20px rgba(0,0,0,.85),0 0 80px -10px rgba(217,182,92,.35);background:#14110C">
          <img class="sl" src="{{ 'jewelry-rings-premium.png' | asset_url }}" alt="Solitaire ring" style="width:100%;height:100%;object-fit:cover">
        </div>
      </figure>
    </div>
  </div>

  <!-- 5-Category Gallery Grid -->
  <div id="jewel-gallery" style="position:relative;z-index:3;max-width:1240px;margin:60px auto 0;padding:0 24px">
    <div style="text-align:center;margin-bottom:48px">
      <div style="font-size:12px;font-weight:800;letter-spacing:.2em;color:#E8C875;text-transform:uppercase;margin-bottom:12px">CURATED PIECES</div>
      <h2 class="disp goldtxt" style="margin:0;font-size:clamp(32px,4vw,56px)">The Jewellery Categories</h2>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:24px">
      <!-- Item 1 -->
      <a href="{{ routes.all_products_collection_url }}" class="card" style="position:relative;display:block;border-radius:20px;overflow:hidden;background:#14110C;border:1px solid rgba(217,182,92,.3);padding:24px;text-decoration:none;transition:transform .4s,border-color .4s">
        <div style="aspect-ratio:1/1;border-radius:14px;overflow:hidden;margin-bottom:20px;background:#1a1610">
          <img src="{{ 'jewelry-rings-premium.png' | asset_url }}" alt="Solitaire Rings" style="width:100%;height:100%;object-fit:cover" loading="lazy">
        </div>
        <div style="font-size:11px;font-weight:800;letter-spacing:.18em;color:#E8C875;margin-bottom:6px">01 / FINE JEWELRY</div>
        <h3 class="serif" style="margin:0;font-size:24px;color:#F4EEDF">Solitaire Rings</h3>
        <p style="margin:8px 0 16px;font-size:14px;color:#A99F8D;line-height:1.5">Cut to catch every light. Handcrafted 18k and 22k gold settings.</p>
        <span style="font-size:12px;font-weight:800;letter-spacing:.14em;color:#E8C875">VIEW RINGS &rarr;</span>
      </a>

      <!-- Item 2 -->
      <a href="{{ routes.all_products_collection_url }}" class="card" style="position:relative;display:block;border-radius:20px;overflow:hidden;background:#14110C;border:1px solid rgba(217,182,92,.3);padding:24px;text-decoration:none;transition:transform .4s,border-color .4s">
        <div style="aspect-ratio:1/1;border-radius:14px;overflow:hidden;margin-bottom:20px;background:#1a1610">
          <img src="{{ 'jewelry-necklaces-premium.png' | asset_url }}" alt="Diamond Pendants" style="width:100%;height:100%;object-fit:cover" loading="lazy">
        </div>
        <div style="font-size:11px;font-weight:800;letter-spacing:.18em;color:#E8C875;margin-bottom:6px">02 / FINE JEWELRY</div>
        <h3 class="serif" style="margin:0;font-size:24px;color:#F4EEDF">Diamond Pendants</h3>
        <p style="margin:8px 0 16px;font-size:14px;color:#A99F8D;line-height:1.5">One stone, worn close. Elevated everyday chains and solitaires.</p>
        <span style="font-size:12px;font-weight:800;letter-spacing:.14em;color:#E8C875">VIEW PENDANTS &rarr;</span>
      </a>

      <!-- Item 3 -->
      <a href="{{ routes.all_products_collection_url }}" class="card" style="position:relative;display:block;border-radius:20px;overflow:hidden;background:#14110C;border:1px solid rgba(217,182,92,.3);padding:24px;text-decoration:none;transition:transform .4s,border-color .4s">
        <div style="aspect-ratio:1/1;border-radius:14px;overflow:hidden;margin-bottom:20px;background:#1a1610">
          <img src="{{ 'jewelry-bridal-premium.png' | asset_url }}" alt="Wedding Bands" style="width:100%;height:100%;object-fit:cover" loading="lazy">
        </div>
        <div style="font-size:11px;font-weight:800;letter-spacing:.18em;color:#E8C875;margin-bottom:6px">03 / FINE JEWELRY</div>
        <h3 class="serif" style="margin:0;font-size:24px;color:#F4EEDF">Bridal &amp; Wedding Bands</h3>
        <p style="margin:8px 0 16px;font-size:14px;color:#A99F8D;line-height:1.5">Begin the story beautifully. Timeless bands engineered for lifelong wear.</p>
        <span style="font-size:12px;font-weight:800;letter-spacing:.14em;color:#E8C875">VIEW BANDS &rarr;</span>
      </a>

      <!-- Item 4 -->
      <a href="{{ routes.all_products_collection_url }}" class="card" style="position:relative;display:block;border-radius:20px;overflow:hidden;background:#14110C;border:1px solid rgba(217,182,92,.3);padding:24px;text-decoration:none;transition:transform .4s,border-color .4s">
        <div style="aspect-ratio:1/1;border-radius:14px;overflow:hidden;margin-bottom:20px;background:#1a1610">
          <img src="{{ 'jewelry-pearls-premium.png' | asset_url }}" alt="Pearl Strands" style="width:100%;height:100%;object-fit:cover" loading="lazy">
        </div>
        <div style="font-size:11px;font-weight:800;letter-spacing:.18em;color:#E8C875;margin-bottom:6px">04 / FINE JEWELRY</div>
        <h3 class="serif" style="margin:0;font-size:24px;color:#F4EEDF">Pearl Strands</h3>
        <p style="margin:8px 0 16px;font-size:14px;color:#A99F8D;line-height:1.5">A soft, living glow. Cultured South Sea and Freshwater pearls.</p>
        <span style="font-size:12px;font-weight:800;letter-spacing:.14em;color:#E8C875">VIEW PEARLS &rarr;</span>
      </a>

      <!-- Item 5 -->
      <a href="{{ routes.all_products_collection_url }}" class="card" style="position:relative;display:block;border-radius:20px;overflow:hidden;background:#14110C;border:1px solid rgba(217,182,92,.3);padding:24px;text-decoration:none;transition:transform .4s,border-color .4s">
        <div style="aspect-ratio:1/1;border-radius:14px;overflow:hidden;margin-bottom:20px;background:#1a1610">
          <img src="{{ 'jewelry-bracelets-premium.png' | asset_url }}" alt="Gold Bracelets" style="width:100%;height:100%;object-fit:cover" loading="lazy">
        </div>
        <div style="font-size:11px;font-weight:800;letter-spacing:.18em;color:#E8C875;margin-bottom:6px">05 / FINE JEWELRY</div>
        <h3 class="serif" style="margin:0;font-size:24px;color:#F4EEDF">Gold Bracelets &amp; Bangles</h3>
        <p style="margin:8px 0 16px;font-size:14px;color:#A99F8D;line-height:1.5">Light on the wrist. Solid links, delicate chains, and statement cuffs.</p>
        <span style="font-size:12px;font-weight:800;letter-spacing:.14em;color:#E8C875">VIEW BRACELETS &rarr;</span>
      </a>
    </div>
  </div>
</div>

</section>

<style>
  .deedap-jewelry-page {
    width: 100%;
    position: relative;
    background: #0B0A08;
    color: #F4EEDF;
    overflow-x: hidden;
    font-family: 'Manrope', system-ui, -apple-system, sans-serif;
  }
  .deedap-jewelry-page .card:hover {
    transform: translateY(-8px);
    border-color: rgba(217,182,92,.8) !important;
  }
  

.dd{font-family:'Manrope',system-ui,sans-serif;color:#F4EEDF;position:relative;overflow-x:clip}
.dd .deedap-jewelry-page * { box-sizing: border-box; }
.dd .deedap-jewelry-page a { color: inherit; text-decoration: none; }
.disp{font-family:'Syne','Arial Black',sans-serif;font-weight:800;text-transform:uppercase}
.serif{font-family:'Cormorant Garamond',Georgia,serif}

/* ---------- entrance ---------- */
.mask{display:block;overflow:hidden;padding-bottom:.12em;margin-bottom:-.12em}
.rise{display:block;animation:rise 1.2s cubic-bezier(.2,.8,.2,1) both}
@keyframes rise{
from{transform:none}
to{transform:translateY(0)}
}
.fadeup{animation:fadeup 1.1s cubic-bezier(.2,.8,.2,1) both}
@keyframes fadeup{
from{opacity:1;transform:none}
to{opacity:1;transform:none}
}
.ringIn{animation:ringIn 1.8s cubic-bezier(.2,.8,.2,1) 1.8s both}
@keyframes ringIn{
from{opacity:0;transform:scale(.82) rotate(-8deg)}
to{opacity:1;transform:none}
}

/* ---------- ambient loops ---------- */
.float{animation:float 7s ease-in-out infinite}
@keyframes float{
0%,100%{transform:translateY(0)}
50%{transform:translateY(-18px)}
}
.spin{animation:spin 56s linear infinite;transform-box:view-box;transform-origin:50% 50%}
.spinRev{animation:spin 40s linear infinite reverse;transform-box:view-box;transform-origin:50% 50%}
@keyframes spin{to{transform:rotate(360deg)}}
.glow{animation:glow 6s ease-in-out infinite}
@keyframes glow{
0%,100%{opacity:.55;transform:scale(1)}
50%{opacity:1;transform:scale(1.1)}
}
.spark{animation:twinkle 3.8s ease-in-out infinite}
@keyframes twinkle{
0%,100%{opacity:.1;transform:scale(.4) rotate(0deg)}
50%{opacity:1;transform:scale(1) rotate(45deg)}
}
.gemf{animation:facet 3.6s ease-in-out infinite}
@keyframes facet{
0%,100%{opacity:.74}
50%{opacity:1}
}
.f2{animation-delay:-.4s}.f3{animation-delay:-.9s}.f4{animation-delay:-1.3s}.f5{animation-delay:-1.8s}
.f6{animation-delay:-2.2s}.f7{animation-delay:-2.6s}.f8{animation-delay:-3s}.f9{animation-delay:-.7s}.f10{animation-delay:-1.6s}
.shine{animation:shineRun 5.5s linear infinite}
@keyframes shineRun{to{stroke-dashoffset:-1000}}
.draw{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 3.4s cubic-bezier(.3,.7,.2,1) .5s forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.sway{animation:sway 5s ease-in-out infinite alternate;transform-box:view-box}
@keyframes sway{
from{transform:rotate(-4deg)}
to{transform:rotate(4deg)}
}
.goldtxt{background:linear-gradient(100deg,#8F6B1F 0%,#D9B65C 22%,#FFF1BE 40%,#C9A24B 58%,#8F6B1F 100%);background-size:240% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;animation:shimmer 4.5s ease-in-out infinite alternate}
@keyframes shimmer{
from{background-position:0% 0}
to{background-position:100% 0}
}
.pulseDot{animation:pulseDot 2.2s ease-out infinite}
@keyframes pulseDot{
0%{box-shadow:0 0 0 0 rgba(217,182,92,.6)}
100%{box-shadow:0 0 0 12px rgba(217,182,92,0)}
}
.scrollLine{animation:scrollLine 2.4s ease-in-out infinite;transform-origin:top}
@keyframes scrollLine{
0%{transform:scaleY(0);opacity:0}
40%{transform:scaleY(1);opacity:1}
100%{transform:scaleY(1);opacity:0}
}
.drift{animation:drift 14s ease-in-out infinite alternate}
@keyframes drift{
from{transform:translate(0,0)}
to{transform:translate(40px,-30px)}
}

/* ---------- marquee ---------- */
.mq{display:flex;width:max-content;animation:mq 42s linear infinite}
@keyframes mq{to{transform:translateX(-50%)}}

/* ---------- nav ---------- */
.nl{position:relative;color:#D8CDB6;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:10px 0;transition:color .3s}
.nl:after{content:"";position:absolute;left:0;right:0;bottom:4px;height:1px;background:#D9B65C;transform:scaleX(0);transform-origin:left;transition:transform .45s cubic-bezier(.2,.8,.2,1)}
.nl:hover{color:#F4D98F}
.nl:hover:after,.nl.on:after{transform:scaleX(1)}
.nl.on{color:#E8C875}
.btn{transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s,translate .25s ease-out}
.btn:hover{transform:translateY(-3px);box-shadow:0 18px 40px -12px rgba(217,182,92,.55)}
.ghost{color:#F4EEDF;text-decoration:none;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:14px 4px;border-bottom:1px solid rgba(244,238,223,.4);transition:color .3s,border-color .3s}
.ghost:hover{color:#F4D98F;border-color:#F4D98F}

/* ---------- category cards ---------- */
.card{top:0;transform:perspective(1100px) rotateX(var(--tx,0deg)) rotateY(var(--ty,0deg));transition:transform .45s cubic-bezier(.2,.8,.2,1),top .7s cubic-bezier(.2,.8,.2,1),box-shadow .7s;will-change:transform}
.card:hover{top:-14px;box-shadow:0 50px 80px -30px rgba(20,17,12,.6),0 0 0 1px rgba(217,182,92,.55)}
.card:before{content:"";position:absolute;inset:0;border-radius:inherit;background:radial-gradient(420px circle at var(--px,50%) var(--py,50%),rgba(255,236,176,.34),transparent 62%);opacity:0;transition:opacity .5s;pointer-events:none;z-index:2}
.card:hover:before{opacity:1}
.card .art{translate:calc(var(--nx,0)*-14px) calc(var(--ny,0)*-9px);transition:transform .9s cubic-bezier(.2,.8,.2,1),translate .35s ease-out}
.card:hover .art{transform:scale(1.07) rotate(-2deg)}
.card:after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 35%,rgba(255,255,255,.3) 50%,transparent 65%);transform:translateX(-130%);transition:transform 1.1s ease;pointer-events:none}
.card:hover:after{transform:translateX(130%)}
.card .go{transition:background .4s,color .4s,transform .5s,border-color .4s}
.card:hover .go{background:#C9A24B;color:#14110C;border-color:#C9A24B;transform:rotate(-45deg)}
.card:focus-visible{outline:3px solid #C9A24B;outline-offset:4px}

/* ---------- metal chooser ---------- */
.mbtn{transition:background .3s,border-color .3s,transform .3s;cursor:pointer;font-family:inherit}
.mbtn:hover{transform:translateY(-2px)}
.mbtn:focus-visible{outline:3px solid #F4D98F;outline-offset:3px}

/* ---------- scroll driven (progressive) ---------- */
@keyframes reveal{
from{opacity:0;translate:0 90px;scale:.94;filter:blur(10px)}
to{opacity:1;translate:0 0;scale:1;filter:blur(0)}
}
@keyframes fillup{
from{background-position:0 100%}
to{background-position:0 0}
}
@keyframes lineGrow{
from{transform:scaleX(0)}
to{transform:scaleX(1)}
}
.fill{color:#14110C}
.growline{transform-origin:left}
@supports (animation-timeline: view()){
.reveal{animation:reveal linear both;animation-timeline:view();animation-range:entry 0% entry 42%}
.growline{animation:lineGrow linear both;animation-timeline:view();animation-range:entry 10% entry 80%}
.fill{background:linear-gradient(180deg,#14110C 0%,#14110C 42%,rgba(20,17,12,.16) 58%,rgba(20,17,12,.16) 100%);background-size:100% 260%;background-position:0 0;-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;animation:fillup linear both;animation-timeline:view();animation-range:entry 35% cover 52%}
}

/* ---------- cinematic intro curtain ---------- */
.curtain{display:none!important;visibility:hidden!important}
@keyframes cOut{to{opacity:0}}
@keyframes cHide{to{visibility:hidden}}
.iBg{position:absolute;inset:0;background:radial-gradient(circle at 50% calc(50% - 85px),rgba(201,162,75,.2),transparent 52%);animation:fadeup 1.6s ease .2s both}
.iLine{position:absolute;left:0;right:0;top:calc(50% - 85px);height:1px;background:linear-gradient(90deg,transparent,#E8C875 28%,#FFF1BE 50%,#E8C875 72%,transparent);transform-origin:center;animation:iLine 1.2s cubic-bezier(.7,0,.2,1) both}
@keyframes iLine{
0%{transform:scaleX(0);opacity:0}
18%{opacity:1}
45%{transform:scaleX(1)}
100%{transform:scaleX(.02);opacity:0}
}
.iStage{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:34px;transform-origin:50% calc(50% - 85px);animation:dive .75s cubic-bezier(.75,0,.2,1) 1.5s forwards}
@keyframes dive{to{transform:scale(5.5);opacity:0}}
.iGem{width:260px;height:229px;overflow:visible;filter:drop-shadow(0 0 36px rgba(255,226,150,.32))}
.ig{fill-opacity:0;stroke:#E8C875;stroke-width:1.6;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:1;animation:igDraw .65s cubic-bezier(.4,0,.2,1) calc(.1s + var(--i)*.05s) forwards,igFill .5s ease calc(.7s + var(--i)*.03s) forwards}
@keyframes igDraw{to{stroke-dashoffset:0}}
@keyframes igFill{to{fill-opacity:1}}
.iGlint{position:absolute;top:calc(50% - 85px);left:50%;width:1000px;height:2px;margin-left:-500px;background:linear-gradient(90deg,transparent,#fff 50%,transparent);box-shadow:0 0 30px 6px rgba(255,236,176,.6);opacity:0;animation:glint .8s ease-out 1s both}
@keyframes glint{
0%{opacity:0;transform:scaleX(0)}
30%{opacity:1;transform:scaleX(1)}
100%{opacity:0;transform:scaleX(1.25)}
}
.iFlare{position:absolute;left:calc(50% - 54px);top:calc(50% - 150px);width:220px;height:220px;margin:-110px 0 0 -110px;opacity:0;animation:flare .9s ease-out .95s both}
@keyframes flare{
0%{opacity:0;transform:scale(0) rotate(0deg)}
35%{opacity:1;transform:scale(1) rotate(45deg)}
100%{opacity:0;transform:scale(.3) rotate(100deg)}
}
.iWord{display:flex;gap:.3em;padding-left:.3em;font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;font-size:clamp(40px,6vw,76px);line-height:1;color:#F4EEDF}
.lt{display:inline-block;opacity:0;animation:lt .7s cubic-bezier(.2,.8,.2,1) calc(.85s + var(--i)*.05s) forwards}
@keyframes lt{
from{opacity:0;filter:blur(16px);transform:translateY(34px) scale(1.25)}
to{opacity:1;filter:blur(0);transform:none}
}
.iSub{display:flex;align-items:center;gap:16px;margin-top:-12px;font-size:11px;font-weight:800;letter-spacing:.38em;color:#E3BE5E;animation:fadeup .6s ease 1.2s both}
.iSub i{display:block;width:60px;height:1px;background:#C9A24B}
.iCorner{position:absolute;font-size:11px;font-weight:800;letter-spacing:.26em;color:#B9AE98;text-transform:uppercase;animation:fadeup .7s ease .1s both}
.iFlash{position:absolute;inset:0;background:radial-gradient(circle at 50% calc(50% - 85px),rgba(255,244,205,.95),rgba(255,226,150,0) 58%);opacity:0;animation:flash .7s ease-out 1.35s both}
@keyframes flash{
0%{opacity:0}
30%{opacity:1}
100%{opacity:0}
}

/* ---------- cursor, spotlight, tilt ---------- */
.spot{position:absolute;inset:0;z-index:2;pointer-events:none;background:radial-gradient(460px circle at var(--hx,72%) var(--hy,38%),rgba(255,226,150,.17),transparent 70%)}
.tilt{transform:perspective(1300px) rotateY(calc(var(--rx,0)*16deg)) rotateX(calc(var(--ry,0)*-12deg));transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.cursor{position:fixed;left:0;top:0;width:44px;height:44px;margin:-22px 0 0 -22px;border:1px solid rgba(217,182,92,.85);border-radius:50%;pointer-events:none;z-index:99;opacity:0;transition:width .35s,height .35s,margin .35s,background .35s,opacity .35s}
.cursor.big{width:86px;height:86px;margin:-43px 0 0 -43px;background:rgba(217,182,92,.14)}
.cursor:after{content:"";position:absolute;left:50%;top:50%;width:5px;height:5px;margin:-2.5px 0 0 -2.5px;border-radius:50%;background:#F4D98F}

/* ---------- gold dust + rays ---------- */
.ptc{position:absolute;bottom:-20px;border-radius:50%;background:radial-gradient(circle,#FFF1BE,#D9B65C 55%,rgba(217,182,92,0) 72%);opacity:0;animation:ptc linear infinite;pointer-events:none}
@keyframes ptc{
0%{transform:translate(0,0) scale(.6);opacity:0}
15%{opacity:.95}
100%{transform:translate(var(--dx,30px),-880px) scale(1.15);opacity:0}
}
.rays{position:absolute;left:50%;top:50%;width:1000px;height:1000px;margin:-500px 0 0 -500px;background:repeating-conic-gradient(from 0deg,rgba(255,233,168,.14) 0deg 3deg,transparent 3deg 15deg);-webkit-mask-image:radial-gradient(circle,#000 0,transparent 64%);mask-image:radial-gradient(circle,#000 0,transparent 64%);animation:raySpin 90s linear infinite;pointer-events:none}
@keyframes raySpin{to{transform:rotate(360deg)}}
.turn{animation:turn 8s ease-in-out infinite alternate}
@keyframes turn{
from{transform:perspective(900px) rotateY(-24deg)}
to{transform:perspective(900px) rotateY(24deg)}
}
.mq.rev{animation-direction:reverse;animation-duration:58s}
.mq:hover{animation-play-state:paused}
.outline{color:transparent;-webkit-text-stroke:1px #C9A24B;font-family:'Syne',sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:.04em}

/* ---------- scroll progress, sticky nav, parallax ---------- */
.prog{position:sticky;top:0;height:3px;margin-bottom:-3px;z-index:60;background:linear-gradient(90deg,#8F6B1F,#F4D98F,#C9A24B);transform-origin:left;transform:scaleX(0)}
@keyframes progress{to{transform:scaleX(1)}}
@keyframes plx{
from{translate:0 160px;rotate:-12deg}
to{translate:0 -160px;rotate:14deg}
}
@keyframes heroOut{
from{opacity:1;translate:0 0;scale:1}
to{opacity:0;translate:0 -90px;scale:.95}
}
@supports (animation-timeline: view()){
.prog{animation:progress linear both;animation-timeline:scroll()}
.plx{animation:plx linear both;animation-timeline:view();animation-range:cover}
}
html.ddready .curtain{display:none!important;visibility:hidden!important}
html.ddready .fadeup,html.ddready .rise:not(.goldtxt),html.ddready .ringIn{animation:none !important;opacity:1 !important;transform:none !important}

@media (max-width:1000px){
.navlinks{display:none !important}
}
@media (hover:none){
.cursor{display:none}
}
@media (prefers-reduced-motion:reduce){
.dd *,.dd *:before,.dd *:after{animation:none !important;transition:none !important}
.curtain,.cursor{display:none !important}
}


/* Ensure 100% immediate visibility on page load - no blank states or hidden overlays */
.curtain { display: none !important; visibility: hidden !important; pointer-events: none !important; }
.pop, .l, .in, .rise, .fadeup, .ringIn, .clipin, .reveal, .mask > span {
  opacity: 1 !important;
  transform: none !important;
  clip-path: none !important;
  visibility: visible !important;
}
.mask { overflow: visible !important; }

</style>

