.fw{--s:1;position:absolute;width:0;height:0}

.fw .core{position:absolute;left:-7px;top:-7px;width:14px;height:14px;border-radius:50%;background:var(--c);box-shadow:0 0 22px 8px var(--c);opacity:0;animation:flash 4.8s var(--dl) ease-out infinite}

.fw .sp{position:absolute;left:0;top:0;width:22px;height:3px;border-radius:3px;background:linear-gradient(90deg,rgba(255,255,255,0),var(--c));transform-origin:0 50%;opacity:0;--d:100px;animation:spark 4.8s var(--dl) cubic-bezier(.1,.7,.3,1) infinite}

.fw .sp.b{--d:62px;background:linear-gradient(90deg,rgba(255,255,255,0),var(--c2));width:16px}

@keyframes spark{0%{opacity:0;transform:rotate(var(--a)) translateX(0) scaleX(.2)}6%{opacity:1}45%{opacity:1;transform:rotate(var(--a)) translateX(calc(var(--d)*var(--s))) scaleX(1)}70%{opacity:.8}100%{opacity:0;transform:rotate(var(--a)) translateX(calc(var(--d)*var(--s)*1.3)) translateY(26px) scaleX(.3)}}

@keyframes flash{0%{opacity:0;transform:scale(.2)}5%{opacity:1;transform:scale(1.4)}25%,100%{opacity:0;transform:scale(2.4)}}



/* ---------- embers + petals + stars ---------- */

.ember{position:absolute;bottom:14px;width:5px;height:5px;border-radius:50%;background:#FFD76A;box-shadow:0 0 10px 3px rgba(255,190,70,.85);opacity:0;animation:ember linear infinite}

@keyframes ember{0%{opacity:0;transform:translate3d(0,0,90px)}10%{opacity:1}50%{transform:translate3d(var(--dx),-320px,90px)}100%{opacity:0;transform:translate3d(calc(var(--dx)*-.6),-660px,90px)}}

.petal{position:absolute;top:0;border-radius:60% 40% 60% 40%;background:radial-gradient(circle at 35% 30%,#FFD76A,#EE7F14 72%);animation:fallA linear infinite;opacity:0}

.petalB{animation-name:fallB}

@keyframes fallA{0%{opacity:0;transform:translate3d(0,-40px,100px) rotate(0deg)}8%{opacity:1}50%{transform:translate3d(-34px,380px,100px) rotate(260deg)}92%{opacity:.9}100%{opacity:0;transform:translate3d(24px,890px,100px) rotate(540deg)}}

@keyframes fallB{0%{opacity:0;transform:translate3d(0,-40px,100px) rotate(0deg)}8%{opacity:1}50%{transform:translate3d(36px,380px,100px) rotate(-240deg)}92%{opacity:.9}100%{opacity:0;transform:translate3d(-26px,890px,100px) rotate(-520deg)}}

.star{position:absolute;width:3px;height:3px;border-radius:50%;background:#FFE29A;animation:twink 2.4s ease-in-out infinite}

.floor{animation:floor 10s ease-in-out infinite alternate}

@keyframes floor{0%{transform:scale(1);opacity:.55}100%{transform:scale(.9) translateX(30px);opacity:.4}}



.rise.gl{animation:rise .9s cubic-bezier(.2,.9,.2,1) var(--t) both,glowbox 2.8s ease-in-out calc(var(--t) + 1s) infinite}

@keyframes glowbox{0%,100%{box-shadow:0 18px 30px rgba(0,0,0,.35),0 0 0 0 rgba(245,196,81,0)}50%{box-shadow:0 18px 30px rgba(0,0,0,.35),0 0 34px 6px rgba(245,196,81,.55)}}

.rays{background:repeating-conic-gradient(from var(--ang) at 50% 80%,rgba(255,226,154,.34) 0deg 8deg,rgba(255,226,154,0) 8deg 22deg);-webkit-mask-image:radial-gradient(ellipse 75% 90% at 50% 80%,#000 0%,transparent 100%);mask-image:radial-gradient(ellipse 75% 90% at 50% 80%,#000 0%,transparent 100%);animation:spin 16s linear infinite}

.ring{position:absolute;left:50%;top:50%;width:90px;height:90px;margin:-45px 0 0 -45px;border:2px solid #F5C451;border-radius:50%;opacity:0;animation:ripple 2.4s ease-out 3s infinite}

@keyframes ripple{0%{opacity:.85;transform:scale(.6)}100%{opacity:0;transform:scale(2.4)}}

.shoot{position:absolute;left:0;width:150px;height:3px;border-radius:3px;background:linear-gradient(90deg,rgba(224,165,38,0),#E0A526 70%,#FFF3C4);opacity:0;animation:shoot 14s linear infinite}

@keyframes shoot{0%{opacity:0;transform:translate(-200px,0) rotate(13deg)}2%{opacity:1}12%{opacity:1}16%,100%{opacity:0;transform:translate(1500px,350px) rotate(13deg)}}

.drop svg ellipse[fill="#E8573F"],.drop svg ellipse[fill="#FFE29A"]{animation:lamp 1.3s ease-in-out infinite alternate}

@keyframes lamp{0%{opacity:.55}100%{opacity:1}}

@media (prefers-reduced-motion: reduce){*{animation:none !important}.petal,.ember,.fw .sp,.fw .core{opacity:0}}



</style>



<script>

(function() {

  function updateScale() {

    var container = document.getElementById('dd-diwali-hero-container');

    var scaler = document.getElementById('dd-diwali-hero-scaler');

    if (!container || !scaler) return;

    var w = container.clientWidth || window.innerWidth;

    var scale = w / 1920;

    scaler.style.transform = 'scale(' + scale + ')';

    container.style.height = Math.round(625 * scale) + 'px';

  }



  if (document.readyState === 'loading') {

    document.addEventListener('DOMContentLoaded', updateScale);

  } else {

    updateScale();

  }



  window.addEventListener('resize', updateScale);

  window.addEventListener('load', updateScale);

})();

</script>



