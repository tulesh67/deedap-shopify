      endif
    endfor

    if c_key contains 'cloth' or c_key contains 'textil'
      if target_handle contains 'shirt' and all_products['shirt'] != empty
        assign fallback_product_url = all_products['shirt'].url
      else
        assign fallback_product_url = '/pages/textiles'
      endif
    elsif c_key contains 'tech' or c_key contains 'electr'
      assign fallback_product_url = '/pages/electronics'
    elsif c_key contains 'jewel'
      assign fallback_product_url = '/pages/jewelry'
    elsif c_key contains 'access'
      assign fallback_product_url = '/pages/accessories'
    elsif c_key contains 'cook'
      assign fallback_product_url = '/#cookware'
    elsif c_key contains 'organic'
      assign fallback_product_url = '/#organic'
    elsif c_key contains 'hamper'
      assign fallback_product_url = '/#hampers'
    elsif c_key contains 'bag'
      assign fallback_product_url = '/#bags'
    else
      assign fallback_product_url = '/collections/all'
    endif
  endif
-%}

<article
  class="na-sq na-pop"
  style="animation-delay: {{ anim_delay }}s; cursor: pointer;"
  data-title="{{ name | escape }}"
  data-price="{{ price_cents | money }}"
  data-category="{{ cat | escape }}"
  data-color="{{ color }}"
  data-description="{{ desc | escape }}"
  data-image="{{ img_url }}"
  data-variant-id="{{ fallback_variant_id }}"
  data-product-url="{{ fallback_product_url }}"
>
  <div class="na-sqimg" style="background-color: {{ tint }};">
    <a href="{{ fallback_product_url }}" class="na-zoom" aria-label="{{ name | escape }}">
      {%- if img_url != blank -%}
        <img src="{{ img_url }}" alt="{{ name | escape }}" loading="lazy" width="600" height="600">
      {%- endif -%}
    </a>
    <span class="na-new-pill">NEW</span>
    <button
      type="button"
      class="na-addb na-sqadd"
      data-variant-id="{{ fallback_variant_id }}"
      data-product-url="{{ fallback_product_url }}"
      aria-label="Add {{ name | escape }} to bag"
      aria-pressed="false"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
    </button>
  </div>
  <div class="na-meta">
    {%- if show_category -%}
      <div class="na-cat-badge">
        <span class="na-cat-badge-dot" style="background-color: {{ color }};"></span>
        <span>{{ cat }}</span>
      </div>
    {%- endif -%}
    <h3 class="na-prod-title">
      <a href="{{ fallback_product_url }}" style="text-decoration:none;color:inherit;">{{ name }}</a>
    </h3>
    <div class="na-prod-price">{{ price_cents | money }}</div>
  </div>
</article>
