{{ 'textiles-style.css' | asset_url | stylesheet_tag }}
{% comment %}
  DEEDAP Native Textiles Landing Page
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">

<section class="deedap-textile-page" data-section-id="{{ section.id }}">
  {%- liquid
    assign men_url = routes.all_products_collection_url
    assign women_url = routes.all_products_collection_url
    assign kids_url = routes.all_products_collection_url
    if section.settings.men_collection != blank
      assign men_url = section.settings.men_collection.url
    endif
    if section.settings.women_collection != blank
      assign women_url = section.settings.women_collection.url
    endif
    if section.settings.kids_collection != blank
      assign kids_url = section.settings.kids_collection.url
    endif
  -%}

  <div style="position:relative;width:100%;background:#fbfaf8;overflow:hidden" data-canvas-width="1440" data-canvas-height="3900" data-document-role="page" data-label="Deedap Textiles">

  

  <!-- ============ HERO ============ -->
  <section id="top" style="position:relative;min-height:980px;overflow:hidden">
    <div class="gridbg" aria-hidden="true"></div>
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>
    <div class="blob b3" aria-hidden="true"></div>

    <svg aria-hidden="true" sc-camel-view-box="0 0 1440 980" sc-camel-preserve-aspect-ratio="none" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none">
      <defs>
        <linearGradient id="tg" x1="0" x2="1"><stop offset="0" stop-color="#b8923a"></stop><stop offset="1" stop-color="#7a5c1f"></stop></linearGradient>
      </defs>
      <path class="thread" sc-camel-path-length="1" stroke="url(#tg)" d="M-20,780 C220,560 420,980 700,720 S1180,380 1460,560"></path>
      <path class="thread t2" sc-camel-path-length="1" stroke="#0f1014" d="M-20,300 C260,120 520,520 760,300 S1200,60 1460,260"></path>
      <path class="thread t3" sc-camel-path-length="1" stroke="url(#tg)" d="M-20,900 C300,700 640,940 900,820 S1280,620 1460,760"></path>
      <path class="thread t2" sc-camel-path-length="1" stroke="#b8923a" d="M200,-20 C360,300 120,520 380,760 S620,920 640,1000"></path>
    </svg>

    <!-- nav -->
    <div class="pop" data-deedap-scroll-header style="--k:0;position:relative;z-index:10;max-width:1320px;margin:0 auto;padding:32px 40px 0;display:flex;flex-wrap:wrap;gap:16px 32px;align-items:center;justify-content:space-between">
      <a href="#top" class="navlink" style="font-size:12px;font-weight:800;letter-spacing:.18em;color:#4a4f5c">← DEEDAP HOME</a>
      <nav aria-label="Collections" style="display:flex;flex-wrap:wrap;gap:28px;font-size:12px;font-weight:800;letter-spacing:.18em">
        <a href="#fit" class="navlink">MEN</a>
        <a href="#fit" class="navlink">WOMEN</a>
        <a href="#fit" class="navlink">KIDS</a>
      </nav>
    </div>

    <div style="position:relative;z-index:4;max-width:1320px;margin:0 auto;padding:90px 40px 60px;display:flex;flex-wrap:wrap;gap:20px 20px;align-items:center">

      <div style="flex:1 1 560px;min-width:0">
        <div class="pop" style="--k:0;display:flex;align-items:center;gap:12px;font-size:12px;font-weight:800;letter-spacing:.18em;color:#7a5c1f;margin-bottom:24px">
          <span class="glowdot" style="width:10px;height:10px;border-radius:50%;background:#b8923a;display:inline-block"></span>
          DEEDAP TEXTILES / THE EVERYDAY EDIT
        </div>

        <h1 class="disp" style="margin:0;font-size:clamp(46px,7.6vw,112px);line-height:.96;letter-spacing:-.01em;perspective:900px">
          <span style="display:block;white-space:nowrap"><span class="l c-w" style="--i:0">W</span><span class="l c-w" style="--i:1">E</span><span class="l c-w" style="--i:2">A</span><span class="l c-w" style="--i:3">R</span></span>
          <span style="display:block;white-space:nowrap"><span class="l c-w" style="--i:4">W</span><span class="l c-w" style="--i:5">H</span><span class="l c-w" style="--i:6">A</span><span class="l c-w" style="--i:7">T</span></span>
          <span style="display:block;white-space:nowrap"><span class="l c-o" style="--i:8">F</span><span class="l c-o" style="--i:9">E</span><span class="l c-o" style="--i:10">E</span><span class="l c-o" style="--i:11">L</span><span class="l c-o" style="--i:12">S</span></span>
          <span style="display:block;white-space:nowrap"><span class="l c-g" style="--i:13">L</span><span class="l c-g" style="--i:14">I</span><span class="l c-g" style="--i:15">K</span><span class="l c-g" style="--i:16">E</span></span>
          <span style="display:block;white-space:nowrap"><span class="l c-g" style="--i:17">Y</span><span class="l c-g" style="--i:18">O</span><span class="l c-g" style="--i:19">U</span><span class="l c-g" style="--i:20">.</span></span>
        </h1>

        <p class="pop" style="--k:1;margin:32px 0 0;max-width:460px;font-size:18px;line-height:1.65;color:#4a4f5c">Thoughtful textiles for the way you move through every day. Explore considered pieces for men, women, and kids.</p>
        <div class="pop" style="--k:2;margin-top:36px">
          <a href="#fit" class="btn" style="display:inline-flex;align-items:center;gap:12px;min-height:56px;padding:0 34px;border-radius:999px;background:#0f1014;color:#fff;font-size:13px;font-weight:800;letter-spacing:.1em">EXPLORE THE COLLECTION <span class="arrow">→</span></a>
        </div>
      </div>

      <!-- 3D ring -->
      <div style="flex:1 1 440px;min-width:0">
        <div class="scene" role="img" aria-label="A rotating ring of woven fabric swatches">
          <div class="floor" aria-hidden="true"></div>
          <div class="core" aria-hidden="true"></div>
          <div class="ring" aria-hidden="true">
            <div class="pnl" style="--n:0;background:linear-gradient(160deg,#f6efe2,#d2bd96)"></div>
            <div class="pnl" style="--n:1;background:linear-gradient(160deg,#e6d6b8,#a8864a)"></div>
            <div class="pnl" style="--n:2;background:linear-gradient(160deg,#fbf5ea,#c9b48a)"></div>
            <div class="pnl" style="--n:3;background:linear-gradient(160deg,#c9a24d,#6b5121)"></div>
            <div class="pnl" style="--n:4;background:linear-gradient(160deg,#4a3b20,#15110a)"></div>
            <div class="pnl" style="--n:5;background:linear-gradient(160deg,#d9c49a,#8a6a2a)"></div>
            <div class="pnl" style="--n:6;background:linear-gradient(160deg,#f1ebdf,#b89c6a)"></div>
            <div class="pnl" style="--n:7;background:linear-gradient(160deg,#b8923a,#4a3510)"></div>
            <div class="pnl" style="--n:8;background:linear-gradient(160deg,#ecd9b4,#b8923a)"></div>
            <div class="pnl" style="--n:9;background:linear-gradient(160deg,#8a6a2a,#2a1f0c)"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="pop" style="--k:3;position:relative;z-index:4;max-width:1320px;margin:0 auto;padding:0 40px 40px;display:flex;flex-wrap:wrap;gap:12px 28px;font-size:12px;font-weight:800;letter-spacing:.16em;color:#4a4f5c">
      <span style="color:#7a5c1f">01</span><span>SELECTED WITH CARE</span><span>MADE FOR EVERY DAY</span>
    </div>
  </section>

  <!-- ============ GIANT MARQUEES ============ -->
  <section aria-hidden="true" style="position:relative;padding:60px 0;transform:rotate(-2.5deg);margin:0 -40px;background:#0f1014;color:#fbfaf8">
    <div class="mq disp">
      <div class="mtrack a">
        <div><span class="w out">Men</span><span class="star">✦</span><span class="w">Women</span><span class="star">✦</span><span class="w out">Kids</span><span class="star">✦</span><span class="w">Textiles</span><span class="star">✦</span></div>
        <div><span class="w out">Men</span><span class="star">✦</span><span class="w">Women</span><span class="star">✦</span><span class="w out">Kids</span><span class="star">✦</span><span class="w">Textiles</span><span class="star">✦</span></div>
      </div>
    </div>
    <div class="mq disp">
      <div class="mtrack b">
        <div><span class="w">Soft</span><span class="star">✦</span><span class="w out">Durable</span><span class="star">✦</span><span class="w">Everyday</span><span class="star">✦</span><span class="w out">Yours</span><span class="star">✦</span></div>
        <div><span class="w">Soft</span><span class="star">✦</span><span class="w out">Durable</span><span class="star">✦</span><span class="w">Everyday</span><span class="star">✦</span><span class="w out">Yours</span><span class="star">✦</span></div>
      </div>
    </div>
  </section>

  <!-- ============ FIND YOUR FIT ============ -->
  <section id="fit" style="position:relative;max-width:1320px;margin:0 auto;padding:180px 40px 140px">
    <div aria-hidden="true" class="blob" style="width:600px;height:600px;right:-10%;top:10%;background:radial-gradient(circle,rgba(201,162,77,.3),rgba(201,162,77,0) 70%)"></div>
    <div class="reveal" style="position:relative;display:flex;flex-wrap:wrap;gap:20px 40px;align-items:flex-end;justify-content:space-between;margin-bottom:64px">
      <div>
        <div style="display:flex;align-items:center;gap:12px;font-size:12px;font-weight:800;letter-spacing:.18em;color:#7a5c1f;margin-bottom:20px">
          <span class="glowdot" style="width:10px;height:10px;border-radius:50%;background:#b8923a;display:inline-block"></span>THE TEXTILE COLLECTION
        </div>
        <h2 class="disp" style="margin:0;font-size:clamp(48px,8vw,128px);line-height:.95">Find your <span class="c-g">fit.</span></h2>
      </div>
      <p style="margin:0;max-width:260px;font-size:15px;line-height:1.6;color:#4a4f5c">Three worlds. One considered point of view.</p>
    </div>

    <div style="position:relative;display:flex;flex-wrap:wrap;gap:28px;align-items:stretch">

      <!-- MEN -->
      <div class="wrap w1 clipin" style="--r0:-4deg">
        <a href="{{ men_url }}" class="card">
          <img class="textile-photo" src="{{ "textiles-men-premium.png" | asset_url }}" alt="Men's natural linen outfit in charcoal studio lighting" loading="lazy" decoding="async">
          <div class="textile-photo-shade" aria-hidden="true"></div>
          <div class="sheen" aria-hidden="true"></div>
          <div class="bignum disp" aria-hidden="true">01</div>
          <div style="position:absolute;top:24px;left:24px;padding:9px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.6);background:rgba(7,7,10,.4);font-size:11px;font-weight:800;letter-spacing:.14em;z-index:4">01 / TEXTILES</div>
          <div style="position:relative;z-index:4;padding:32px">
            <div style="font-size:11px;font-weight:800;letter-spacing:.16em;margin-bottom:12px;color:#e6d6b8">EASY, EVERYDAY LAYERS</div>
            <div class="cardtitle disp">Men</div>
            <p style="margin:16px 0 26px;max-width:300px;font-size:15px;line-height:1.55;color:#e8e5dc">Versatile staples and thoughtful details for wherever the day takes you.</p>
            <div style="display:flex;align-items:center;justify-content:space-between"><span style="font-size:12px;font-weight:800;letter-spacing:.14em">EXPLORE MEN</span><span class="go arrow" style="transition:transform .6s cubic-bezier(.2,.8,.2,1),background .3s,color .3s">→</span></div>
          </div>
        </a>
      </div>

      <!-- WOMEN -->
      <div class="wrap w2 clipin" style="--r0:0deg">
        <a href="{{ women_url }}" class="card">
          <img class="textile-photo" src="{{ "textiles-women-premium.png" | asset_url }}" alt="Women's ivory blouse and taupe trousers in a charcoal studio" loading="lazy" decoding="async">
          <div class="textile-photo-shade" aria-hidden="true"></div>
          <div class="sheen" aria-hidden="true" style="animation-delay:-1.6s"></div>
          <div class="bignum disp" aria-hidden="true">02</div>
          <div style="position:absolute;top:24px;left:24px;padding:9px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.6);background:rgba(7,7,10,.4);font-size:11px;font-weight:800;letter-spacing:.14em;z-index:4">02 / TEXTILES</div>
          <div style="position:relative;z-index:4;padding:32px">
            <div style="font-size:11px;font-weight:800;letter-spacing:.16em;margin-bottom:12px;color:#e6d6b8">A LITTLE ROOM TO SHINE</div>
            <div class="cardtitle disp">Women</div>
            <p style="margin:16px 0 26px;max-width:300px;font-size:15px;line-height:1.55;color:#e8e5dc">Comfortable silhouettes and expressive pieces, chosen to feel like you.</p>
            <div style="display:flex;align-items:center;justify-content:space-between"><span style="font-size:12px;font-weight:800;letter-spacing:.14em">EXPLORE WOMEN</span><span class="go arrow" style="transition:transform .6s cubic-bezier(.2,.8,.2,1),background .3s,color .3s">→</span></div>
          </div>
        </a>
      </div>

      <!-- KIDS -->
      <div class="wrap w3 clipin" style="--r0:4deg">
        <a href="{{ kids_url }}" class="card">
          <img class="textile-photo textile-photo-kids" src="{{ "textiles-kids-premium.png" | asset_url }}" alt="Child wearing an oatmeal knit sweater and olive trousers" loading="lazy" decoding="async">
          <div class="textile-photo-shade" aria-hidden="true"></div>
          <div class="sheen" aria-hidden="true" style="animation-delay:-3.2s"></div>
          <div class="bignum disp" aria-hidden="true">03</div>
          <div style="position:absolute;top:24px;left:24px;padding:9px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.6);background:rgba(7,7,10,.4);font-size:11px;font-weight:800;letter-spacing:.14em;z-index:4">03 / TEXTILES</div>
          <div style="position:relative;z-index:4;padding:32px">
            <div style="font-size:11px;font-weight:800;letter-spacing:.16em;margin-bottom:12px;color:#e6d6b8">READY FOR EVERY ADVENTURE</div>
            <div class="cardtitle disp">Kids</div>
            <p style="margin:16px 0 26px;max-width:300px;font-size:15px;line-height:1.55;color:#e8e5dc">Soft, durable favorites for curious minds and busy little days.</p>
            <div style="display:flex;align-items:center;justify-content:space-between"><span style="font-size:12px;font-weight:800;letter-spacing:.14em">EXPLORE KIDS</span><span class="go arrow" style="transition:transform .6s cubic-bezier(.2,.8,.2,1),background .3s,color .3s">→</span></div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SCROLL-FILL STATEMENT ============ -->
  <section style="position:relative;max-width:1320px;margin:0 auto;padding:60px 40px 160px;overflow:hidden">
    <div class="disp fillw">Soft.</div>
    <div class="disp fillw" style="padding-left:12%">Durable.</div>
    <div class="disp fillw" style="padding-left:24%">Yours.</div>
  </section>

  <!-- ============ CTA ============ -->
  <section style="position:relative;overflow:hidden;background:#f1ebdf;border-top:1px solid rgba(15,16,20,.1)">
    <div class="blob" aria-hidden="true" style="width:800px;height:800px;left:50%;top:50%;margin:-400px 0 0 -400px;background:radial-gradient(circle,rgba(122,92,31,.35),rgba(255,150,60,0) 65%);animation:bl1 10s ease-in-out infinite"></div>
    <div class="fl" aria-hidden="true" style="left:8%;top:22%;--s:46px;--d:8s"></div>
    <div class="fl f" aria-hidden="true" style="left:18%;top:64%;--s:24px;--d:6s"></div>
    <div class="fl" aria-hidden="true" style="left:30%;top:14%;--s:28px;--d:10s"></div>
    <div class="fl f" aria-hidden="true" style="right:10%;top:18%;--s:30px;--d:7s"></div>
    <div class="fl" aria-hidden="true" style="right:20%;top:66%;--s:54px;--d:11s"></div>
    <div class="fl f" aria-hidden="true" style="right:32%;top:80%;--s:20px;--d:5s"></div>

    <div style="position:relative;max-width:1320px;margin:0 auto;padding:160px 40px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:48px">
      <h2 class="disp zoom" style="margin:0;font-size:clamp(52px,10vw,160px);line-height:.95">Woven to<br><span class="c-g">live in.</span></h2>
      <div style="position:relative;width:240px;height:240px">
        <div class="ripple" style="--i:0" aria-hidden="true"></div>
        <div class="ripple" style="--i:1" aria-hidden="true"></div>
        <div class="ripple" style="--i:2" aria-hidden="true"></div>
        <a href="{{ routes.all_products_collection_url }}" class="orb">SHOP THE EDIT &rarr;</a>
      </div>
    </div>
  </section>

  <footer style="max-width:1320px;margin:0 auto;padding:28px 40px;display:flex;flex-wrap:wrap;gap:12px 24px;justify-content:space-between;font-size:12px;font-weight:700;letter-spacing:.14em;color:#4a4f5c">
    <span>© DEEDAP TEXTILES</span>
    <a href="#top" class="navlink">BACK TO THE TOP ↑</a>
  </footer>

</div>
</section>

<style>
  .deedap-textile-page {
    width: 100%;
    position: relative;
    background: #fbfaf8;
    overflow-x: hidden;
    color: #0f1014;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  }
  .deedap-textile-page img.textile-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .deedap-textile-page .textile-photo-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7,7,10,0.15) 0%, rgba(7,7,10,0.65) 60%, rgba(7,7,10,0.92) 100%);
    z-index: 2;
  }
  .deedap-textile-page .wrap {
    flex: 1 1 320px;
    min-width: 280px;
    position: relative;
  }
  .deedap-textile-page .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 520px;
    border-radius: 28px;
    overflow: hidden;
    color: #fbfaf8;
    text-decoration: none;
    background: #15110a;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .deedap-textile-page .card:hover {
    transform: translateY(-8px);
    box-shadow: 0 24px 48px -12px rgba(15,16,20,0.35);
  }
  .deedap-textile-page .cardtitle {
    font-size: 38px;
    font-weight: 800;
    line-height: 1;
  }
  .deedap-textile-page .arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    font-size: 18px;
  }
  .deedap-textile-page .card:hover .arrow {
    background: #fff;
    color: #0f1014;
    transform: translateX(4px);
  }
  .deedap-textile-page .c-g { color: #b8923a; }
  .deedap-textile-page .c-w { color: #0f1014; }
  .deedap-textile-page .c-o { color: #7a5c1f; }
  .deedap-textile-page .disp { font-family: 'Syne', sans-serif; font-weight: 800; text-transform: uppercase; }
  .deedap-textile-page .fillw {
    font-size: clamp(64px, 12vw, 180px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    font-weight: 800;
    color: rgba(15, 16, 20, 0.08);
    transition: color 0.4s ease;
  }
  .deedap-textile-page .fillw:hover {
    color: #0f1014;
  }
  .deedap-textile-page .orb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #0f1014;
    color: #fbfaf8;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-decoration: none;
    box-shadow: 0 20px 40px rgba(0,0,0,0.25);
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .deedap-textile-page .orb:hover {
    background: #b8923a;
    color: #fff;
    transform: scale(1.05);
  }

  
