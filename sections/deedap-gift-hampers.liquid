<section class="dd-gh{% if section.settings.banner_asset != blank %} dd-gh--banner{% endif %}" aria-label="Gift hampers">
  {% assign diya_product = section.settings.product_diya %}
  {% assign diya_variant = diya_product.selected_or_first_available_variant %}
  {% assign cashew_product = section.settings.product_cashews %}
  {% assign cashew_variant = cashew_product.selected_or_first_available_variant %}
  {% assign festive_product = section.settings.product_festive %}
  {% assign festive_variant = festive_product.selected_or_first_available_variant %}
  {% if section.settings.banner_asset != blank %}<a class="dd-gh__banner" href="#dd-gh-products" aria-label="Shop gift hampers"><img src="{{ section.settings.banner_asset | asset_url }}" alt="The Gifting Guide — Wrapped, Ready &amp; Iconic" width="736" height="292" fetchpriority="high"></a>{% else %}
  <div class="dd-gh__intro">
    <p class="dd-gh__eyebrow">A LITTLE JOY, BEAUTIFULLY BOXED</p>
    <h1 id="dd-gh-title">Gifts that feel <em>like a celebration.</em></h1>
    <p class="dd-gh__lead">Thoughtful festive hampers, ready to make someone’s day. Choose the box that feels just right.</p>
    <div class="dd-gh__assurance"><span>✦ Festive ready</span><span>✦ Thoughtfully packed</span><span>✦ Made for sharing</span></div>
  </div>
  {% endif %}

  <div id="dd-gh-products" class="dd-gh__products" aria-label="Gift hamper options">
    <article class="dd-gh-card">
      <a class="dd-gh-card__image" href="{{ diya_product.url | default: '/pages/contact' }}" aria-label="Hamper with Brass Diya">
        <img src="{{ 'gift-hamper-diya.jpg' | asset_url }}" alt="Festive gift hamper with four jars and a decorative brass diya" width="1536" height="1024" fetchpriority="high">
        <span class="dd-gh-card__number">OPTION 01</span>
      </a>
      <div class="dd-gh-card__body">
        <p class="dd-gh-card__type">THE FESTIVE FAVOURITE</p>
        <h2>Hamper with Brass Diya</h2>
        <p class="dd-gh-card__description">A colourful festive gift box, paired with a decorative brass diya.</p>
        <div class="dd-gh-card__foot"><strong>{% if diya_product != blank %}{{ diya_product.price | money }}{% else %}₹350/-{% endif %}</strong>{% if diya_variant != blank and diya_variant.available %}<button class="dd-gh-add" type="button" data-deedap-add data-variant-id="{{ diya_variant.id }}" aria-label="Add Hamper with Brass Diya to bag">ADD TO BAG <span aria-hidden="true">＋</span></button>{% else %}<button class="dd-gh-add" type="button" disabled title="Select an available Shopify product for this option in the theme editor">ADD TO BAG <span aria-hidden="true">＋</span></button>{% endif %}</div>
      </div>
    </article>

    <article class="dd-gh-card dd-gh-card--featured">
      <a class="dd-gh-card__image" href="{{ cashew_product.url | default: '/pages/contact' }}" aria-label="Hamper with 100 gram cashews">
        <img src="{{ 'gift-hamper-cashews.png' | asset_url }}" alt="Festive gift hamper with four jars and a gift box" width="1536" height="1024" loading="lazy">
        <span class="dd-gh-card__number">OPTION 02</span>
        <span class="dd-gh-card__ribbon">A THOUGHTFUL EXTRA</span>
      </a>
      <div class="dd-gh-card__body">
        <p class="dd-gh-card__type">THE SHARING BOX</p>
        <h2>Hamper with 100 g Cashews</h2>
        <p class="dd-gh-card__description">A colourful festive gift box, with 100 g of cashews to share.</p>
        <div class="dd-gh-card__foot"><strong>{% if cashew_product != blank %}{{ cashew_product.price | money }}{% else %}₹365/-{% endif %}</strong>{% if cashew_variant != blank and cashew_variant.available %}<button class="dd-gh-add" type="button" data-deedap-add data-variant-id="{{ cashew_variant.id }}" aria-label="Add Hamper with Cashews to bag">ADD TO BAG <span aria-hidden="true">＋</span></button>{% else %}<button class="dd-gh-add" type="button" disabled title="Select an available Shopify product for this option in the theme editor">ADD TO BAG <span aria-hidden="true">＋</span></button>{% endif %}</div>
      </div>
    </article>

    <article class="dd-gh-card">
      <a class="dd-gh-card__image" href="{{ festive_product.url | default: '/pages/contact' }}" aria-label="Festive gift hamper">
        <img src="{{ 'gift-hamper-festive.png' | asset_url }}" alt="A selection of colourful festive gift hamper boxes" width="906" height="600" loading="lazy">
        <span class="dd-gh-card__number">OPTION 03</span>
      </a>
      <div class="dd-gh-card__body">
        <p class="dd-gh-card__type">THE JOYFUL GESTURE</p>
        <h2>Festive Gift Hamper</h2>
        <p class="dd-gh-card__description">A bright, ready-to-gift festive box for sharing a little joy.</p>
        <div class="dd-gh-card__foot"><strong>{% if festive_product != blank %}{{ festive_product.price | money }}{% else %}₹250/-{% endif %}</strong>{% if festive_variant != blank and festive_variant.available %}<button class="dd-gh-add" type="button" data-deedap-add data-variant-id="{{ festive_variant.id }}" aria-label="Add Festive Gift Hamper to bag">ADD TO BAG <span aria-hidden="true">＋</span></button>{% else %}<button class="dd-gh-add" type="button" disabled title="Select an available Shopify product for this option in the theme editor">ADD TO BAG <span aria-hidden="true">＋</span></button>{% endif %}</div>
      </div>
    </article>
  </div>

  <footer class="dd-gh__footer"><span>THE DEEDAP FESTIVE EDIT</span><a href="/">CONTINUE EXPLORING DEEDAP ↑</a></footer>
</section>

<style>
  .dd-gh{--gh-ink:#281b16;--gh-wine:#64182b;--gh-gold:#bd8a36;--gh-cream:#ffffff;color:var(--gh-ink);background:var(--gh-cream);padding:clamp(32px,4vw,58px) max(22px,calc((100vw - 1320px)/2)) 24px;font-family:var(--font-body-family,inherit)}
  .dd-gh--banner{padding:0 0 24px}.dd-gh__banner{display:block;width:100%;line-height:0}.dd-gh__banner img{display:block;width:100%;height:auto}.dd-gh--banner .dd-gh__products,.dd-gh--banner .dd-gh__footer{width:calc(100% - 44px)}.dd-gh--banner .dd-gh__products{margin-top:18px}
  .dd-gh__intro{text-align:center;max-width:1320px;margin:0 auto 32px}.dd-gh__eyebrow,.dd-gh-card__type{font-size:11px;font-weight:800;letter-spacing:.2em;color:var(--gh-gold)}.dd-gh__eyebrow{margin:0 0 10px}.dd-gh__intro h1{font-family:var(--font-heading-family,Georgia,serif);font-size:clamp(28px,3.5vw,46px);line-height:1.12;letter-spacing:-.045em;margin:0 auto;color:var(--gh-wine);white-space:nowrap}.dd-gh__intro h1 em{display:inline;font-weight:500;color:var(--gh-ink)}.dd-gh__lead{max-width:none;margin:12px auto 16px;font-size:15px;line-height:1.5;color:#6f6258;white-space:nowrap}.dd-gh__assurance{display:flex;justify-content:center;gap:22px;flex-wrap:wrap;font-size:12px;font-weight:700;letter-spacing:.04em;color:#76552c}
  .dd-gh__products{max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;align-items:stretch}.dd-gh-card{background:#fff;border:3.5px solid #5C091E !important;border-radius:18px;overflow:hidden;box-shadow:0 12px 36px rgba(49,30,15,.08);transition:transform .25s ease,box-shadow .25s ease}.dd-gh-card:hover{transform:translateY(-5px);box-shadow:0 20px 48px rgba(49,30,15,.14)}.dd-gh-card--featured{border-color:rgba(189,138,54,.65);box-shadow:0 16px 42px rgba(100,24,43,.14)}.dd-gh-card__image{display:block;position:relative;aspect-ratio:1.12;background:#eee7dc;overflow:hidden}.dd-gh-card__image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .5s ease}.dd-gh-card:hover .dd-gh-card__image img{transform:scale(1.035)}.dd-gh-card__number{position:absolute;top:15px;left:15px;padding:9px 12px;border-radius:999px;background:rgba(255,252,244,.95);color:var(--gh-wine);font-size:10px;font-weight:900;letter-spacing:.13em}.dd-gh-card__ribbon{position:absolute;right:14px;top:15px;padding:9px 11px;border-radius:3px;background:var(--gh-wine);color:white;font-size:9px;font-weight:800;letter-spacing:.1em}.dd-gh-card__body{padding:22px 23px 20px}.dd-gh-card__type{margin:0 0 9px;font-size:9px}.dd-gh-card h2{margin:0;color:var(--gh-ink);font-family:var(--font-heading-family,Georgia,serif);font-size:24px;line-height:1.18}.dd-gh-card__description{min-height:48px;margin:10px 0 19px;color:#71655d;font-size:13px;line-height:1.55}.dd-gh-card__foot{border-top:1px solid #eee8df;padding-top:16px;display:flex;align-items:center;justify-content:space-between;gap:12px}.dd-gh-card__foot strong{font-size:27px;color:var(--gh-wine);letter-spacing:-.04em}.dd-gh-add{display:inline-flex;align-items:center;gap:10px;padding:11px 15px;border:0;border-radius:999px;background:var(--gh-wine);color:#fff;font-size:10px;font-weight:850;letter-spacing:.08em;cursor:pointer}.dd-gh-add:hover{background:#481020}.dd-gh-add:disabled{opacity:.48;cursor:not-allowed}.dd-gh__footer{max-width:1320px;margin:42px auto 0;padding-top:18px;border-top:1px solid rgba(100,24,43,.18);display:flex;justify-content:space-between;gap:15px;color:#876e5d;font-size:10px;font-weight:800;letter-spacing:.13em}.dd-gh__footer a{color:var(--gh-wine);text-decoration:none}
  @media(max-width:900px){.dd-gh__products{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.dd-gh-card__body{padding:18px}.dd-gh-card h2{font-size:21px}}
  @media(max-width:600px){.dd-gh{padding:34px 16px 22px}.dd-gh--banner{padding:0 0 20px}.dd-gh__intro{margin-bottom:26px}.dd-gh__intro h1{max-width:100%;font-size:clamp(24px,7vw,34px);letter-spacing:-.055em;white-space:normal;line-height:1.08}.dd-gh__intro h1 em{display:block}.dd-gh__lead{max-width:34em;margin:12px auto 16px;font-size:clamp(13px,3.5vw,14px);white-space:normal}.dd-gh__assurance{gap:9px 16px;font-size:10px}.dd-gh__products{grid-template-columns:1fr;max-width:430px}.dd-gh-card__image{aspect-ratio:1.18}.dd-gh-card__description{min-height:0}.dd-gh__footer{font-size:9px;letter-spacing:.07em}}
</style>

{% schema %}
{
  "name": "DEEDAP Gift Hampers",
  "settings": [
    { "type": "product", "id": "product_diya", "label": "Shopify product for Option 1 Add to Bag" },
    { "type": "product", "id": "product_cashews", "label": "Shopify product for Option 2 Add to Bag" },
    { "type": "product", "id": "product_festive", "label": "Shopify product for Option 3 Add to Bag" },
    { "type": "text", "id": "banner_asset", "label": "Banner asset filename" }
  ],
  "presets": [{ "name": "DEEDAP Gift Hampers" }]
}
{% endschema %}
