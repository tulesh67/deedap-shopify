<script>
/* ---- filter ---- */
function cwFilter(btn, cat) {
  document.querySelectorAll('.cw-filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.cw-prod-card').forEach(card => {
    if (cat === 'all' || card.dataset.cat === cat) {
      card.style.display = 'flex';
    } else {
      card.style.display = 'none';
    }
  });
}

/* ---- scroll reveal ---- */
(function() {
  var els = document.querySelectorAll('.cw-reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    els.forEach(function(el) { io.observe(el); });
  } else {
    els.forEach(function(el) { el.classList.add('visible'); });
  }
})();

/* ---- wishlist toggle ---- */
document.querySelectorAll('.cw-prod-wishlist').forEach(function(btn) {
  btn.addEventListener('click', function() {
    this.textContent = this.textContent === '♡' ? '♥' : '♡';
    this.style.color = this.textContent === '♥' ? '#E8401A' : '#B8923A';
  });
});

/* ---- smooth scroll ---- */
document.querySelectorAll('a[href^="#cw-"]').forEach(function(a) {
  a.addEventListener('click', function(e) {
    var target = document.querySelector(this.getAttribute('href'));
    if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
  });
});
</script>

