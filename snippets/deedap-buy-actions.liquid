{% comment %}
  Add to cart + Buy now for a Shopify product.
  Accepts:
    - product: Product
    - hide_add: Boolean (default false)
{% endcomment %}
{%- liquid
  assign action_product = product
  assign action_variant = action_product.selected_or_first_available_variant
-%}
{%- if action_product.available and action_variant != blank -%}
  <div class="deedap-buy-actions" data-deedap-actions>
    {%- unless hide_add -%}
      <button
        type="button"
        class="deedap-buy-actions__add"
        data-deedap-add
        data-variant-id="{{ action_variant.id }}"
      >
        Add to cart
      </button>
    {%- endunless -%}
    <button
      type="button"
      class="deedap-buy-actions__buy"
      data-deedap-buy
      data-deedap-order-trigger
      data-variant-id="{{ action_variant.id }}"
      data-product-title="{{ action_product.title | escape }}"
      data-product-price="{{ action_variant.price | divided_by: 100.0 }}"
      data-product-image="{{ action_product.featured_image | image_url: width: 400 }}"
    >
      Buy now
    </button>
  </div>
{%- else -%}
  <div class="deedap-buy-actions">
    <button type="button" class="deedap-buy-actions__add" disabled>Sold out</button>
  </div>
{%- endif -%}
