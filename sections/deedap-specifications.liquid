<section class="page-width deedap-specs-showcase" id="specs">
  <div class="deedap-section-header">
    <div>
      <div class="deedap-kicker">{{ section.settings.kicker | default: '03 // Verification Architecture' }}</div>
      <h2 class="deedap-heading-xl">{{ section.settings.heading | default: 'Multi-Attribute Specifications' }}</h2>
    </div>
  </div>

  <div class="specs-showcase-box">
    <div class="specs-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="spec-card" {{ block.shopify_attributes }}>
            <div class="spec-header" style="color: {{ block.settings.header_color | default: 'var(--cat-clothing)' }};">
              <span>{{ block.settings.icon | default: '📋' }}</span> {{ block.settings.title | default: 'Product Spec' }}
            </div>
            {%- if block.settings.row1_label != blank -%}
              <div class="spec-row"><span class="spec-label">{{ block.settings.row1_label }}</span><span class="spec-val">{{ block.settings.row1_val }}</span></div>
            {%- endif -%}
            {%- if block.settings.row2_label != blank -%}
              <div class="spec-row"><span class="spec-label">{{ block.settings.row2_label }}</span><span class="spec-val">{{ block.settings.row2_val }}</span></div>
            {%- endif -%}
            {%- if block.settings.row3_label != blank -%}
              <div class="spec-row"><span class="spec-label">{{ block.settings.row3_label }}</span><span class="spec-val">{{ block.settings.row3_val }}</span></div>
            {%- endif -%}
            {%- if block.settings.row4_label != blank -%}
              <div class="spec-row"><span class="spec-label">{{ block.settings.row4_label }}</span><span class="spec-val">{{ block.settings.row4_val }}</span></div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="spec-card">
          <div class="spec-header" style="color: var(--cat-clothing);"><span>👕</span> Clothing &amp; Textiles Spec</div>
          <div class="spec-row"><span class="spec-label">Fabric Material</span><span class="spec-val">100% Organic Washed Linen</span></div>
          <div class="spec-row"><span class="spec-label">Measurement</span><span class="spec-val">Chest 42&quot;, Length 29.5&quot; (Size M)</span></div>
          <div class="spec-row"><span class="spec-label">Care Guide</span><span class="spec-val">Machine Wash 30°C / Line Dry</span></div>
          <div class="spec-row"><span class="spec-label">Weave Provenance</span><span class="spec-val">Artisan Loom Inspected</span></div>
        </div>
        <div class="spec-card">
          <div class="spec-header" style="color: var(--cat-electronics);"><span>⚡</span> Electronics &amp; Tech Spec</div>
          <div class="spec-row"><span class="spec-label">Compatibility</span><span class="spec-val">Universal USB-C / Bluetooth 5.3</span></div>
          <div class="spec-row"><span class="spec-label">Battery Endurance</span><span class="spec-val">Up to 48 Hours Continuous Play</span></div>
          <div class="spec-row"><span class="spec-label">Warranty</span><span class="spec-val">12-Month DEEDAP Direct Replacement</span></div>
          <div class="spec-row"><span class="spec-label">Safety Mark</span><span class="spec-val">CE, FCC, RoHS Certified</span></div>
        </div>
        <div class="spec-card">
          <div class="spec-header" style="color: var(--cat-honey);"><span>🍯</span> Raw Honey Purity Spec</div>
          <div class="spec-row"><span class="spec-label">Net Weight</span><span class="spec-val">500 grams (17.6 oz)</span></div>
          <div class="spec-row"><span class="spec-label">Purity Level</span><span class="spec-val">100% Raw, Unfiltered &amp; Unheated</span></div>
          <div class="spec-row"><span class="spec-label">Storage Guide</span><span class="spec-val">Store at Room Temp (Avoid Direct Sun)</span></div>
          <div class="spec-row"><span class="spec-label">Harvest Origin</span><span class="spec-val">Highland Wildflower Reserves</span></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

